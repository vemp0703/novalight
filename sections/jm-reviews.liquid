{% if product %}
<section class="jm-design-reviews page-width">

  {% if section.settings.heading != blank %}
    <h2 class="jm-heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <!-- Rating Summary -->
  <div class="jm-rating-summary">
    {% render 'judgeme_preview_badge', product: product %}
  </div>

  <!-- Reviews + Breakdown (Official, Safe) -->
  <div class="jm-reviews-wrapper">
    {% render 'judgeme_all_reviews' %}
  </div>

</section>
{% endif %}

{% schema %}
{
  "name": "Judge.me – Custom Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 10,000+ Customers"
    }
  ],
  "presets": [
    {
      "name": "Judge.me – Design Reviews",
      "category": "Reviews"
    }
  ]
}
{% endschema %}
