<!-- Judge.me Star Rating Badge -->
<div
  class="jdgm-widget jdgm-preview-badge"
  data-product-id="{{ product.id }}"
  data-template="badge"
></div>

<!-- Rating Breakdown Histogram -->
<section class="page-width" style="padding:60px 0">
  <h3 style="text-align:center">Rating Breakdown</h3>

  <div
    class="jdgm-widget jdgm-histogram-widget"
    data-product-id="{{ product.id }}"
    data-template="histogram"
  ></div>
</section>

<!-- Force Judge.me JS Initialization -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    if (window.jdgm && typeof jdgm.init === "function") {
      jdgm.init();
    }
  });
</script>


