{% if product %}

<section class="page-width" style="padding:80px 0">

  <h2 style="text-align:center;font-size:36px;margin-bottom:20px">
    {{ section.settings.heading }}
  </h2>

  <!-- ⭐ Badge -->
  <div style="text-align:center;margin-bottom:40px">
    <div
      class="jdgm-preview-badge"
      data-id="{{ product.id }}"
      data-template="badge"
    ></div>
  </div>

  <!-- 📊 Histogram -->
  {% if section.settings.show_breakdown %}
    <div style="max-width:500px;margin:0 auto 60px">
      <div
        class="jdgm-widget"
        data-product-id="{{ product.id }}"
        data-template="histogram"
      ></div>
    </div>
  {% endif %}

  <!-- 📝 Reviews (MOST IMPORTANT PART) -->
  <div>
    <div
      class="jdgm-widget"
      data-product-id="{{ product.id }}"
      data-template="reviews"
    ></div>
  </div>

</section>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    if (window.jdgm && jdgm.init) {
      jdgm.init();
    }
  });
</script>

{% endif %}

{% schema %}
{
  "name": "Judge.me Reviews (Safe)",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Reviews"
    },
    {
      "type": "checkbox",
      "id": "show_breakdown",
      "label": "Show rating breakdown",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Judge.me Reviews",
      "category": "Reviews"
    }
  ]
}
{% endschema %}
