{% if product %}

{% style %}
/* ================================
   SECTION
================================ */
.jm-design-reviews {
  padding: 80px 0;
  text-align: center;
}

.jm-heading {
  font-size: 38px;
  font-weight: 500;
  margin-bottom: 16px;
}

.jm-rating-summary {
  margin-bottom: 50px;
}

/* Stars */
.jdgm-preview-badge .jdgm-star {
  color: #f5a623 !important;
}

.jdgm-preview-badge__text {
  display: block;
  font-size: 13px;
  color: #6b7280;
  margin-top: 6px;
}

/* ================================
   BREAKDOWN
================================ */
.jm-breakdown-card {
  max-width: 560px;
  margin: 0 auto 70px;
  padding: 32px;
  background: #f9fbfd;
  border-radius: 14px;
  box-shadow: 0 0 0 1px #eef2f7;
  text-align: left;
}

.jm-breakdown-card h4 {
  text-align: center;
  font-size: 18px;
  font-weight: 500;
  margin-bottom: 22px;
}

/* Remove Judge.me default headings */
.jdgm-widget-title,
.jdgm-subtitle {
  display: none !important;
}

/* Histogram */
.jdgm-histogram__bar {
  height: 8px !important;
  border-radius: 20px;
  background: #e5e7eb !important;
}

.jdgm-histogram__bar-content {
  background: linear-gradient(90deg, #ffb703, #ff9800) !important;
  border-radius: 20px;
}

.jdgm-histogram__frequency {
  font-size: 13px;
  color: #6b7280;
}

.jdgm-histogram-widget:empty {
  min-height: 120px;
}

/* ================================
   REVIEWS GRID
================================ */
.jm-review-grid .jdgm-revs-tab {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
}

/* Review card */
.jdgm-rev {
  border: 1px solid #e5e7eb;
  border-radius: 16px;
  padding: 26px;
  background: #fff;
  text-align: left;
}

.jdgm-rev__body {
  font-size: 14px;
  line-height: 1.6;
  color: #374151;
}

.jdgm-rev__author {
  font-weight: 500;
  margin-top: 16px;
}

.jdgm-rev__timestamp {
  font-size: 12px;
  color: #6b7280;
}

/* Responsive */
@media (max-width: 1024px) {
  .jm-review-grid .jdgm-revs-tab {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 640px) {
  .jm-review-grid .jdgm-revs-tab {
    grid-template-columns: 1fr;
  }
}
{% endstyle %}

<section class="jm-design-reviews page-width" id="jm-reviews-{{ section.id }}">

  <!-- Heading -->
  <h2 class="jm-heading">
    {{ section.settings.heading }}
  </h2>

  <!-- Badge -->
  <div class="jm-rating-summary">
    <div
      class="jdgm-preview-badge"
      data-id="{{ product.id }}"
      data-template="badge"
    ></div>
  </div>

  <!-- Breakdown -->
  {% if section.settings.show_breakdown %}
    <div class="jm-breakdown-card">
      <h4>{{ section.settings.breakdown_heading }}</h4>

      <div
        class="jdgm-widget jdgm-histogram-widget"
        data-product-id="{{ product.id }}"
        data-template="histogram"
      ></div>
    </div>
  {% endif %}

  <!-- Reviews -->
  <div class="jm-review-grid">
    <div
      class="jdgm-widget jdgm-reviews-widget"
      data-product-id="{{ product.id }}"
      data-template="reviews"
      data-reviews-per-page="10"
    ></div>
  </div>

</section>

<!-- 🔥 FORCE JUDGEME INIT (CRITICAL FIX) -->
<script>
(function () {
  function initJudgeMe() {
    if (window.jdgm && typeof jdgm.init === "function") {
      jdgm.init();
    }
  }

  document.addEventListener("DOMContentLoaded", initJudgeMe);

  // Extra safety for AJAX / Dawn
  setTimeout(initJudgeMe, 800);
})();
</script>

{% endif %}

{% schema %}
{
  "name": "Judge.me Custom Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by Customers"
    },
    {
      "type": "checkbox",
      "id": "show_breakdown",
      "label": "Show rating breakdown",
      "default": true
    },
    {
      "type": "text",
      "id": "breakdown_heading",
      "label": "Breakdown heading",
      "default": "Rating Breakdown"
    }
  ],
  "presets": [
    {
      "name": "Judge.me Reviews",
      "category": "Reviews"
    }
  ]
}
{% endschema %}
