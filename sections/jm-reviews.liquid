{% if product %}
<section class="jm-design-reviews page-width">

  {%- if section.settings.heading != blank -%}
    <h2 class="jm-heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <!-- Rating Summary -->
  <div class="jm-rating-summary">
    {% render 'judgeme_widgets',
      widget_type: 'judgeme_preview_badge',
      product: product
    %}
  </div>

  <!-- Rating Breakdown -->
  {% if section.settings.show_breakdown %}
  <div class="jm-breakdown-card">
    <h4>{{ section.settings.breakdown_heading }}</h4>

    {% assign total = product.metafields.judgeme.review_count | default: 1 %}

    {% for i in (5..1) %}
      {% assign rating_key = 'rating_' | append: i %}
      {% assign count = product.metafields.judgeme[rating_key] | default: 0 %}
      {% assign percent = count | times: 100 | divided_by: total %}

      <div class="jm-break-row">
        <span class="jm-star-label">{{ i }} ★</span>

        <div class="jm-bar">
          <span style="width: {{ percent }}%"></span>
        </div>

        <span class="jm-count">{{ count }}</span>
      </div>
    {% endfor %}
  </div>
  {% endif %}

  <!-- Reviews Grid -->
  <div class="jm-review-grid">
    {% render 'judgeme_widgets',
      widget_type: 'judgeme_reviews',
      product: product,
      per_page: section.settings.reviews_limit
    %}
  </div>

</section>
{% endif %}

{% schema %}
{
  "name": "Judge.me – Custom Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Loved by 10,000+ Customers"
    },
    {
      "type": "checkbox",
      "id": "show_breakdown",
      "label": "Show rating breakdown",
      "default": true
    },
    {
      "type": "text",
      "id": "breakdown_heading",
      "label": "Breakdown heading",
      "default": "Rating Breakdown"
    },
    {
      "type": "range",
      "id": "reviews_limit",
      "label": "Number of reviews",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Info",
      "settings": [
        {
          "type": "paragraph",
          "content": "Reviews are pulled automatically per product using Judge.me."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Judge.me Reviews",
      "category": "Reviews"
    }
  ]
}
{% endschema %}
