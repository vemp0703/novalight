{% if product %}

    {{ product.id }}
<section class="jm-design-reviews page-width">

  {% if section.settings.heading != blank %}
    <h2 class="jm-heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <!-- Rating Summary -->
  <div class="jm-rating-summary">
    <div
      class="jdgm-preview-badge"
      data-id="{{ product.id }}"
      data-template="badge"
    ></div>
  </div>

  <!-- Rating Breakdown -->
  {% if section.settings.show_breakdown %}
  <div class="jm-breakdown-card">
    <h4>{{ section.settings.breakdown_heading }}</h4>

    <div
      class="jdgm-widget jdgm-review-widget"
      data-product-id="{{ product.id }}"
      data-template="histogram"
    ></div>
  </div>
  {% endif %}

  <!-- Reviews -->
  <div class="jm-review-grid">
    <div
      class="jdgm-widget jdgm-review-widget"
      data-product-id="{{ product.id }}"
      data-template="reviews"
      data-per-page="{{ section.settings.reviews_limit }}"
    ></div>
  </div>

</section>
{% endif %}

{% schema %}
{
  "name": "Judge.me Custom Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 10,000+ Customers"
    },
    {
      "type": "checkbox",
      "id": "show_breakdown",
      "label": "Show rating breakdown",
      "default": true
    },
    {
      "type": "text",
      "id": "breakdown_heading",
      "label": "Breakdown heading",
      "default": "Rating Breakdown"
    },
    {
      "type": "range",
      "id": "reviews_limit",
      "label": "Number of reviews",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Judge.me Reviews",
      "category": "Reviews"
    }
  ]
}
{% endschema %}
