{% style %}
  .jm-design-reviews {
  padding: 80px 0;
  text-align: center;
}

.jm-heading {
  font-size: 36px;
  font-weight: 600;
  margin-bottom: 16px;
}

/* Summary */
.jm-rating-summary {
  margin-bottom: 40px;
}

/* Breakdown Card */
.jm-breakdown-card {
  max-width: 520px;
  margin: 0 auto 60px;
  padding: 28px;
  background: #f9fbfd;
  border-radius: 16px;
  text-align: left;
}

.jm-breakdown-card h4 {
  text-align: center;
  margin-bottom: 20px;
}

/* Hide Judge.me titles */
.jdgm-widget-title,
.jdgm-subtitle {
  display: none !important;
}

/* Histogram bars */
.jdgm-histogram__bar-content {
  background: linear-gradient(90deg, #ffb703, #ff9800) !important;
  border-radius: 20px;
}

/* Reviews Grid */
.jm-review-grid .jdgm-revs-tab {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
}

/* Review Cards */
.jdgm-rev {
  border: 1px solid #e6ecf2;
  border-radius: 16px;
  padding: 24px;
  text-align: left;
}

/* Responsive */
@media (max-width: 1024px) {
  .jm-review-grid .jdgm-revs-tab {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 640px) {
  .jm-review-grid .jdgm-revs-tab {
    grid-template-columns: 1fr;
  }
}

{% endstyle %}
{% if product %}
<section class="jm-design-reviews page-width">

  <!-- Heading -->
  <h2 class="jm-heading">Loved by 10,000+ Customers</h2>

  <!-- Stars + Rating -->
  <div class="jm-rating-summary">
    <div
      class="jdgm-preview-badge"
      data-id="{{ product.id }}"
      data-template="badge"
    ></div>
  </div>

  <!-- Rating Breakdown -->
  <div class="jm-breakdown-card">
    <h4>Rating Breakdown</h4>

    <div
      class="jdgm-widget"
      data-product-id="{{ product.id }}"
      data-template="histogram"
    ></div>
  </div>

  <!-- Reviews -->
  <div class="jm-review-grid">
    <div
      class="jdgm-widget"
      data-product-id="{{ product.id }}"
      data-template="reviews"
      data-per-page="3"
    ></div>
  </div>

</section>
{% endif %}


{% schema %}
{
  "name": "Judge.me Custom Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 10,000+ Customers"
    },
    {
      "type": "checkbox",
      "id": "show_breakdown",
      "label": "Show rating breakdown",
      "default": true
    },
    {
      "type": "text",
      "id": "breakdown_heading",
      "label": "Breakdown heading",
      "default": "Rating Breakdown"
    },
    {
      "type": "range",
      "id": "reviews_limit",
      "label": "Number of reviews",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Judge.me Reviews",
      "category": "Reviews"
    }
  ]
}
{% endschema %}
