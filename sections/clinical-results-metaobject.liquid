{% style %}
.clinical-results {
    padding: 90px 0;
    background: radial-gradient(circle at top, #698c7e 0%, #507365 100%);
    color: #fff;
    text-align: center;
}

.clinical-results__badge span {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 16px;
  border-radius: 999px;
  background: rgba(255,255,255,0.1);
  font-size: 13px;
  margin-bottom: 22px;
}

.clinical-results__heading {
  color: #FFF;
  text-align: center;
  font-family: "Marcellus";
  font-size: 44px;
  font-style: normal;
  font-weight: 400;
  line-height: 52.8px; /* 120% */
  letter-spacing: -0.88px;
}

.clinical-results__subtext {
  color: #CAD5E2;
  text-align: center;
  font-family: "Jost";
  font-size: 17px;
  font-style: normal;
  font-weight: 400;
  line-height: 28.9px; /* 170% */
}

.clinical-results__grid {
  display: grid;
  width: 100%;
  height: auto;
  row-gap: 32px;
  column-gap: 32px;
  grid-template-rows: repeat(1, minmax(0, 1fr));
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin:80px auto
}

.clinical-card {
  background: rgba(255,255,255,0.04);
  border-radius: 18px;
  padding: 38px 26px;
}
.clinical-card h3 {
  background: linear-gradient(90deg, #AD46FF 0%, #F6339A 100%);
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.clinical-card__bar {
  display: block;
  width: 44px;
  height: 3px;
  border-radius: 3px;
  margin: 0 auto 22px;
}

.clinical-card__value {
  text-align: center;
  font-family: "Jost" !important;
  font-size: 45px;
  font-style: normal;
  font-weight: 700;
  line-height: normal;
}

.clinical-card__title {
  color: #FFF;
  text-align: center;
  font-family: "Lato";
  font-size: 20px;
  font-style: normal;
  font-weight: 600;
  line-height: 28px; /* 140% */
  margin:auto;
}

.clinical-card__desc {
  color:rgb(255, 255, 255);
  text-align: center;
  font-family: "Lato";
  font-size: 14px;
  font-style: normal;
  font-weight: 400;
  line-height: 20px; /* 142.857% */
  margin:auto;
}
@media (max-width: 1024px) {
  .clinical-results__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* Mobile → 1 column */
@media (max-width: 640px) {
  .clinical-results__grid {
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }
}
{% endstyle %}

{% assign section_data = product.metafields.custom.clinical_results_section.value %}

{% if section_data != blank and section_data.show_section.value == true %}

<section class="clinical-results">
  <div class="page-width">

    {% if section_data.badge_text != blank %}
      <div class="clinical-results__badge">
        <span>{{ section_data.badge_text }}</span>
      </div>
    {% endif %}

    {% if section_data.heading != blank %}
      <h2 class="clinical-results__heading">{{ section_data.heading }}</h2>
    {% endif %}

    {% if section_data.sub_heading != blank %}
      <p class="clinical-results__subtext">{{ section_data.sub_heading }}</p>
    {% endif %}

    {% if section_data.result_items.value != blank %}
      <div class="clinical-results__grid">
        {% for item in section_data.result_items.value   %}
          <div class="clinical-card">
            <span class="clinical-card__bar"
              style="background: {{ item.accent_color }};"></span>

            <h3 class="clinical-card__value"
              style="color: {{ item.accent_color }};">
              {{ item.value }}
            </h3>

            <h4 class="clinical-card__title">{{ item.title }}</h4>
            <p class="clinical-card__desc">{{ item.description }}</p>
          </div>
        {% endfor %}



      </div>
    {% endif %}
            {% if section_data.disclaimer != blank %}
      <p class="clinical-results__subtext">{{ section_data.disclaimer }}</p>
    {% endif %}
  </div>
</section>

{% endif %}


{% schema %}
{
  "name": "Clinical Results",
  "tag": "section",
  "class": "section-clinical-results",
  "settings": [],
  "presets": [
    {
      "name": "Clinical Results (Metaobject)"
    }
  ]
}
{% endschema %}
