{% assign show_banner = product.metafields.custom.show_promotional_banner.value %}

{% if show_banner %}
  {% assign badge = product.metafields.custom.badge_text.value %}
  {% assign heading = product.metafields.custom.promo_heading.value %}
  {% assign text = product.metafields.custom.promo_description.value %}
  {% assign background_image = product.metafields.custom.background_image.value | file_url %}

{% style %}
  .promo-banner {
    padding: 60px 0;
  }

  .promo-banner__box {
    position: relative;
    border-radius: 18px;
    padding: 56px 40px;
    color: #fff;
    overflow: hidden;
    background-image: url('{{ background_image }}');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .promo-banner__badge {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(255,255,255,0.2);
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 18px;
  }

  .promo-banner__heading {
    font-size: 34px;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 14px;
  }

  .promo-banner__text {
    max-width: 760px;
    font-size: 15px;
    line-height: 1.7;
    opacity: 0.95;
  }

  .promo-banner__box::before,
  .promo-banner__box::after {
    content: "";
    position: absolute;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: rgba(255,255,255,0.08);
  }

  .promo-banner__box::before {
    top: -80px;
    left: -80px;
  }

  .promo-banner__box::after {
    bottom: -90px;
    right: -90px;
  }

  @media (max-width: 768px) {
    .promo-banner__box {
      padding: 40px 24px;
    }

    .promo-banner__heading {
      font-size: 26px;
    }
  }
  {% endstyle %}

  <section class="promo-banner">
    <div class="page-width">
      <div class="promo-banner__box">

        {% if badge != blank %}
          <div class="promo-banner__badge">
            {{ badge }}
          </div>
        {% endif %}

        {% if heading != blank %}
          <h2 class="promo-banner__heading">
            {{ heading }}
          </h2>
        {% endif %}

        {% if text != blank %}
          <p class="promo-banner__text">
            {{ text }}
          </p>
        {% endif %}

      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Product Promo Banner",
  "presets": [
    {
      "name": "Product Promo Banner"
    }
  ]
}
{% endschema %}
