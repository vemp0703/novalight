{% assign show_banner = product.metafields.custom.show_promotional_banner.value %}

{% if show_banner %}
  {% assign badge = product.metafields.custom.badge_text.value %}
  {% assign heading = product.metafields.custom.promo_heading.value %}
  {% assign text = product.metafields.custom.promo_description.value %}
  {% assign background_image = product.metafields.custom.background_image.value | image_url: width: 2000 %}

{% style %}
.promo-banner {
  padding: 60px 0;
}

.promo-banner__box {
  position: relative;
  border-radius: 24px;
  padding: 56px 40px;
  overflow: hidden;

  background-image: url('{{ background_image }}');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  text-align: center;
}

/* overlay for better contrast */
.promo-banner__box::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    rgba(0,0,0,0.25),
    rgba(0,0,0,0.1)
  );
  z-index: 0;
}

.promo-banner__content {
  position: relative;
  z-index: 1;
}

.promo-banner__badge {
  display: inline-flex;
  align-items: center;
  padding: 6px 16px;
  border-radius: 999px;
  background: rgba(255,255,255,0.25);
  color: #fff;
  font-size: 13px;
  font-weight: 500;
  margin-bottom: 18px;
}

.promo-banner__heading {
  font-size: 36px;
  font-weight: 600;
  line-height: 1.3;
  margin-bottom: 14px;
  color: #0b1c2d; /* dark heading like design */
}

.promo-banner__text {
  max-width: 760px;
  margin: 0 auto;
  font-size: 15px;
  line-height: 1.7;
  color: #ffffff;
  opacity: 0.95;
}

@media (max-width: 768px) {
  .promo-banner__box {
    padding: 40px 24px;
  }

  .promo-banner__heading {
    font-size: 26px;
  }
}
{% endstyle %}

<section class="promo-banner">
  <div class="page-width">
    <div class="promo-banner__box">
      <div class="promo-banner__content">

        {% if badge != blank %}
          <div class="promo-banner__badge">
            {{ badge }}
          </div>
        {% endif %}

        {% if heading != blank %}
          <h2 class="promo-banner__heading">
            {{ heading }}
          </h2>
        {% endif %}

        {% if text != blank %}
          <p class="promo-banner__text">
            {{ text }}
          </p>
        {% endif %}

      </div>
    </div>
  </div>
</section>
{% endif %}


{% schema %}
{
  "name": "Product Promo Banner",
  "presets": [
    {
      "name": "Product Promo Banner"
    }
  ]
}
{% endschema %}
