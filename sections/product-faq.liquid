{% assign faq_html = product.metafields.custom.frequent_ask_question | metafield_tag %}

{% if faq_html != blank %}
<section class="product-faq">
  <div class="faq-container">
    <h2 class="faq-title">{{ section.settings.heading }}</h2>
    <p class="faq-subtitle">{{ section.settings.subheading }}</p>

    
    {% assign faq_items = faq_html | metafield_tag %}

    {{ faq_items  }}
    {% assign items = faq_items | metafield_tag | split: '<h6>' %}
    
    {% for item in items %}
      {% if item contains '</h6>' %}
        {% assign parts = item | split: '</h6>' %}
        {% assign question = parts[0] | strip %}
        {% assign answer = parts[1] | strip %}

        <div class="faq-item">
          <button class="faq-question">
            <span>{{ question }}</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            {{ answer }}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<style>
.product-faq {
  padding: 80px 20px;
  background: #f8fbff;
}

.faq-container {
  max-width: 720px;
  margin: auto;
}

.faq-title {
  text-align: center;
  font-size: 32px;
  font-weight: 600;
  margin-bottom: 6px;
}

.faq-subtitle {
  text-align: center;
  color: #6b7280;
  font-size: 14px;
  margin-bottom: 40px;
}

.faq-item {
  background: #fff;
  border: 1px solid #e5edf5;
  border-radius: 12px;
  margin-bottom: 14px;
  overflow: hidden;
}

.faq-question {
  width: 100%;
  padding: 18px 20px;
  background: none;
  border: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  font-size: 15px;
  font-weight: 500;
}

.faq-icon {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: #eef4ff;
  color: #2563eb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  transition: all 0.3s ease;
}

.faq-item.active .faq-icon {
  background: #2563eb;
  color: #fff;
  transform: rotate(180deg);
}

.faq-answer {
  padding: 0 20px;
  font-size: 14px;
  color: #4b5563;
  line-height: 1.6;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease, padding 0.35s ease;
}

.faq-item.active .faq-answer {
  padding: 0 20px 18px;
  max-height: 500px;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const items = document.querySelectorAll('.faq-item');

  items.forEach(item => {
    item.querySelector('.faq-question').addEventListener('click', () => {
      items.forEach(i => {
        if (i !== item) i.classList.remove('active');
      });
      item.classList.toggle('active');
    });
  });
});
</script>
{% endif %}

{% schema %}
{
  "name": "Product FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need to know about TheraFace Mask"
    }
  ],
  "presets": [
    {
      "name": "Product FAQ",
      "category": "Product"
    }
  ]
}
{% endschema %}
