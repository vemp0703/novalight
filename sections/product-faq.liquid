{% assign faq_content = product.metafields.custom.frequent_ask_question.value %}

{% if faq_content != blank %}
<div class="faq-section max-w-2xl mx-auto mt-12">
  {% if section.settings.faq_heading != blank %}
    <h2 class="text-2xl font-bold mb-2">{{ section.settings.faq_heading }}</h2>
  {% endif %}
  {% if section.settings.faq_subheading != blank %}
    <p class="text-gray-600 mb-6">{{ section.settings.faq_subheading }}</p>
  {% endif %}

  {% assign faqs = faq_content | split:'<h6>' %}
  {% for faq in faqs %}
    {% if faq != blank %}
      {% assign parts = faq | split:'</h6>' %}
      {% assign question = parts[0] | strip %}
      {% assign answer = parts[1] | strip %}

      <div class="faq-item border rounded-lg mb-3 p-4 bg-white shadow-sm">
        <button type="button" class="faq-question flex justify-between items-center w-full text-left focus:outline-none">
          <span>{{ question }}</span>
          <span class="faq-toggle">+</span>
        </button>
        <div class="faq-answer mt-2 max-h-0 overflow-hidden transition-all duration-300 text-gray-700">
          {{ answer }}
        </div>
      </div>
    {% endif %}
  {% endfor %}
</div>

<style>
.faq-question {
  font-weight: 600;
  font-size: 1rem;
  cursor: pointer;
}
.faq-toggle {
  transition: transform 0.3s ease;
}
.faq-answer {
  font-size: 0.95rem;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const items = document.querySelectorAll('.faq-item');
  items.forEach(item => {
    const btn = item.querySelector('.faq-question');
    const answer = item.querySelector('.faq-answer');
    const toggle = item.querySelector('.faq-toggle');

    btn.addEventListener('click', () => {
      const isOpen = answer.style.maxHeight && answer.style.maxHeight !== "0px";
      if(isOpen) {
        answer.style.maxHeight = "0px";
        toggle.textContent = '+';
      } else {
        answer.style.maxHeight = answer.scrollHeight + "px";
        toggle.textContent = '-';
      }
    });
  });
});
</script>
{% endif %}

{% schema %}
{
  "name": "FAQ Section",
  "settings": [
    {
      "type": "text",
      "id": "faq_heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "faq_subheading",
      "label": "Subheading",
      "default": "Everything you need to know about the product"
    }
  ],
  "presets": [
    {
      "name": "FAQ Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}
