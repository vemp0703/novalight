{% if product.metafields.custom.sticky_and_scroll_section != blank %}
  {% assign section_items = product.metafields.custom.sticky_and_scroll_section.value %}

  <section class="sticky-scroll-section">
    <!-- Left sticky image -->
    <div class="left-container">
      <img src="{{ section_items.primary_image | img_url: '800x' }}" alt="Image description">
    </div>

    <!-- Right scrolling content -->
    <div class="right-container">
      <h2>{{ section_items.heading }}</h2>
      <p>{{ section_items.sub_heading }}</p>

      <div class="scroll-items">
        {% for item in section_items.section_items.value %}
          <div class="scroll-item">
            <img src="{{ item.image | img_url: '800x' }}" alt="Item image">
            <span class="numeric">{{ item.numeric }}</span>
            <h3>{{ item.heading }}</h3>
            <p>{{ item.content }}</p>
            <div class="gradient" style="background: {{ item.gradient }}"></div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <style>
    .sticky-scroll-section {
      display: flex;
      flex-wrap: wrap;
      gap: 2rem;
    }

    .left-container {
      flex: 1 1 40%;
      position: sticky;
      top: 2rem; /* adjust for your header */
      max-height: 90vh;
    }

    .left-container img {
      width: 100%;
      height: auto;
      object-fit: cover;
      border-radius: 8px;
    }

    .right-container {
      flex: 1 1 55%;
      max-height: 90vh;
      overflow-y: auto;
    }

    .scroll-items {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .scroll-item img {
      width: 100%;
      height: auto;
      border-radius: 6px;
    }

    .numeric {
      font-weight: bold;
      display: block;
      margin-top: 0.5rem;
    }

    .gradient {
      height: 5px;
      margin-top: 0.5rem;
      border-radius: 3px;
    }

    @media (max-width: 768px) {
      .sticky-scroll-section {
        flex-direction: column;
      }
      .left-container, .right-container {
        flex: 1 1 100%;
        position: relative;
        max-height: none;
      }
    }
  </style>
{% endif %}
