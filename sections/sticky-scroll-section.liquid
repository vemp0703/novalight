{% if product.metafields.custom.sticky_and_scroll_section != blank %}
  {% assign section_items = product.metafields.custom.sticky_and_scroll_section.value %}

  <section class="product-sticky-scroll-section mt-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
      
      <!-- Left sticky image -->
      <div class="lg:sticky lg:top-24">
        <img src="{{ section_items.primary_image | img_url: '800x' }}" alt="{{ section_items.heading }}" class="w-full h-auto rounded-lg shadow-md">
      </div>

      <!-- Right scrolling content -->
      <div class="space-y-8">
        <!-- Section Heading -->
        {% if section_items.heading != blank %}
          <h2 class="text-3xl font-bold text-gray-900">{{ section_items.heading }}</h2>
        {% endif %}

        {% if section_items.sub_heading != blank %}
          <p class="text-gray-700 text-base">{{ section_items.sub_heading }}</p>
        {% endif %}

        <!-- Scrollable items -->
        <div class="space-y-6">
          {% for item in section_items.section_items.value %}
            <div class="scroll-item opacity-0 transform translate-y-6 transition-all duration-700 ease-out">
              {% if item.image != blank %}
                <img src="{{ item.image | img_url: '800x' }}" alt="{{ item.heading }}" class="w-full h-auto rounded-md shadow-sm">
              {% endif %}

              {% if item.numeric != blank %}
                <span class="text-lg font-semibold text-gray-900">{{ item.numeric }}</span>
              {% endif %}

              {% if item.heading != blank %}
                <h3 class="text-xl font-medium text-gray-800">{{ item.heading }}</h3>
              {% endif %}

              {% if item.content != blank %}
                <p class="text-gray-600">{{ item.content }}</p>
              {% endif %}

              {% if item.gradient != blank %}
                <div class="h-1 rounded" style="background: {{ item.gradient }}"></div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Optional: maintain Dawn theme spacing on large screens */
    @media (min-width: 1024px) {
      .product-sticky-scroll-section .lg\:sticky {
        top: 6rem; /* adjust according to header height */
      }
    }
  </style>

  <script>
    // Fade-in scroll animation
    document.addEventListener('DOMContentLoaded', function() {
      const items = document.querySelectorAll('.scroll-item');

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.remove('opacity-0', 'translate-y-6');
            entry.target.classList.add('opacity-100', 'translate-y-0');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.2 });

      items.forEach(item => observer.observe(item));
    });
  </script>
{% endif %}
