{% if product.metafields.custom.sticky_and_scroll_section != blank %}
  {% assign section_items = product.metafields.custom.sticky_and_scroll_section.value %}
  
  <section class="sticky-scroll-section">
    <div class="container">
      {% for item in section_items %}
        {% assign item = item | parse_json %}
        <div class="sticky-scroll-wrapper">
          
          <!-- Left Sticky Image -->
          <div class="sticky-image">
            {% if item.primary_image != blank %}
              <img src="{{ item.primary_image | img_url: '800x' }}" alt="{{ item.heading }}">
            {% endif %}
          </div>
          
          <!-- Right Scrollable Content -->
          <div class="scroll-content">
            {% if item.heading != blank %}
              <h2 class="section-heading">{{ item.heading }}</h2>
            {% endif %}
            
            {% if item.sub_heading != blank %}
              <p class="section-subheading">{{ item.sub_heading }}</p>
            {% endif %}
            
            {% if item.items != blank %}
              <div class="items-list">
                {% for content in item.items %}
                  {% assign content = content | parse_json %}
                  <div class="item">
                    {% if content.icon != blank %}
                      <img class="item-icon" src="{{ content.icon | img_url: '100x' }}" alt="">
                    {% endif %}
                    {% if content.numeric != blank %}
                      <span class="item-numeric">{{ content.numeric }}</span>
                    {% endif %}
                    {% if content.title != blank %}
                      <h4 class="item-title">{{ content.title }}</h4>
                    {% endif %}
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          </div>

        </div>
      {% endfor %}
    </div>
  </section>
{% endif %}
