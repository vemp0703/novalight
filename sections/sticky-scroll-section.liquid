{% comment %}
  SECTION: Sticky Image + Scrollable Content (Block Version)
  Shopify section with blocks for dynamic scroll items
{% endcomment %}

<section class="sticky-scroll">
  <div class="page-width sticky-scroll__grid">

    <!-- LEFT: Sticky Image -->
    <div class="sticky-scroll__left">
      {% if section.settings.sticky_image != blank %}
        <img class="sticky-scroll__image"
             src="{{ section.settings.sticky_image | image_url: width: 900 }}"
             alt=""
             loading="lazy">
      {% endif %}
    </div>

    <!-- RIGHT: Scrollable Items -->
    <div class="sticky-scroll__right">
      <div class="sticky-scroll__items">

        {% for block in section.blocks %}
          <div class="sticky-scroll__item" data-index="{{ forloop.index0 }}">
            {% if block.settings.heading != blank %}
              <h2 class="sticky-scroll__heading">{{ block.settings.heading }}</h2>
            {% endif %}

            {% if block.settings.sub_heading != blank %}
              <p class="sticky-scroll__subheading">{{ block.settings.sub_heading }}</p>
            {% endif %}

            {% if block.settings.item_content != blank %}
              <div class="sticky-scroll__list">{{ block.settings.item_content }}</div>
            {% endif %}
          </div>
        {% endfor %}

      </div>
    </div>

  </div>
</section>

<style>
.sticky-scroll {
  padding: 100px 0;
}
.sticky-scroll__grid {
  display: grid;
  grid-template-columns: 45% 55%;
  gap: 60px;
  align-items: flex-start;
}
.sticky-scroll__left {
  position: sticky;
  top: 120px;
}
.sticky-scroll__image {
  width: 100%;
  height: auto;
  border-radius: 16px;
}
.sticky-scroll__right {
  max-height: calc(100vh - 160px);
  overflow-y: auto;
  padding-right: 20px;
}
.sticky-scroll__item {
  padding: 60px 0;
  border-bottom: 1px solid #eee;
}
.sticky-scroll__item:last-child {
  border-bottom: none;
}
.sticky-scroll__heading {
  font-size: 32px;
  font-weight: 600;
  margin-bottom: 12px;
}
.sticky-scroll__subheading {
  font-size: 18px;
  color: #666;
  margin-bottom: 24px;
}
.sticky-scroll__list {
  padding-left: 18px;
}
@media (max-width: 990px) {
  .sticky-scroll__grid {
    grid-template-columns: 1fr;
  }
  .sticky-scroll__left {
    position: relative;
    top: 0;
    margin-bottom: 40px;
  }
  .sticky-scroll__right {
    max-height: none;
    overflow: visible;
    padding-right: 0;
  }
}
</style>

{% schema %}
{
  "name": "Sticky Scroll Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "sticky_image",
      "label": "Sticky Left Image"
    }
  ],
  "blocks": [
    {
      "type": "scroll_item",
      "name": "Scroll Item",
      "settings": [
        {"type": "text", "id": "heading", "label": "Heading"},
        {"type": "text", "id": "sub_heading", "label": "Sub Heading"},
        {"type": "richtext", "id": "item_content", "label": "Content / List"}
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {"name": "Sticky Scroll Section"}
  ]
}
{% endschema %}