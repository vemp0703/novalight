<section class="sticky-scroll-section">
  {% assign sections = product.metafields.custom.sticky_and_scroll_section.value %}
  
  
  {% if sections %}
    {{ sections | json }}
    {% for section in sections %}
      <div class="sticky-scroll-item">

        <!-- Left: Primary Image -->
        {% if section.primary_image %}
          <div class="sticky-scroll-image">
            <img src="{{ section.primary_image | img_url: '600x' }}" alt="{{ section.heading }}">
          </div>
        {% endif %}

        <!-- Right: Heading, Subheading, Scrollable Items -->
        <div class="sticky-scroll-content">
          {% if section.heading %}
            <h2 class="sticky-scroll-heading">{{ section.heading }}</h2>
          {% endif %}
          {% if section.subheading %}
            <p class="sticky-scroll-subheading">{{ section.subheading }}</p>
          {% endif %}

          {% if section.section_items %}
            <div class="sticky-scroll-list">
              {% for item in section.section_items %}
                <div class="scroll-item" style="background: {{ item.gradient }}">
                  {% if item.icon %}
                    <img class="item-icon" src="{{ item.icon | img_url: '50x50' }}" alt="{{ item.heading }}">
                  {% endif %}
                  {% if item.numeric %}
                    <p class="item-numeric">{{ item.numeric }}</p>
                  {% endif %}
                  {% if item.heading %}
                    <p class="item-heading">{{ item.heading }}</p>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          {% endif %}

        </div>
      </div>
    {% endfor %}
  {% endif %}
</section>

<style>
.sticky-scroll-section {
  display: flex;
  flex-direction: column;
  gap: 2rem;
  padding: 2rem;
}

.sticky-scroll-item {
  display: flex;
  gap: 2rem;
  align-items: flex-start;
  flex-wrap: wrap;
}

.sticky-scroll-image {
  flex: 0 0 300px;
  position: sticky;
  top: 2rem;
  height: max-content;
}
.sticky-scroll-image img {
  width: 100%;
  height: auto;
  object-fit: cover;
  border-radius: 1rem;
}

.sticky-scroll-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.sticky-scroll-heading {
  font-size: 1.8rem;
  margin-bottom: 0.5rem;
}
.sticky-scroll-subheading {
  font-size: 1.2rem;
  color: #555;
  margin-bottom: 1rem;
}

.sticky-scroll-list {
  max-height: 300px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.scroll-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem;
  border-radius: 0.8rem;
  color: #fff;
}
.item-icon {
  width: 50px;
  height: 50px;
}
.item-numeric {
  font-weight: bold;
  font-size: 1.5rem;
}
.item-heading {
  font-size: 1rem;
}

@media (max-width: 1024px) {
  .sticky-scroll-item {
    flex-direction: column;
    align-items: center;
  }
  .sticky-scroll-image {
    position: relative;
    width: 100%;
    max-width: 400px;
    margin-bottom: 1.5rem;
  }
  .sticky-scroll-list {
    max-height: 200px;
  }
}

@media (max-width: 600px) {
  .sticky-scroll-heading {
    font-size: 1.5rem;
  }
  .sticky-scroll-subheading {
    font-size: 1rem;
  }
  .sticky-scroll-list {
    max-height: 150px;
  }
}
</style>

{% schema %}
{
  "name": "Sticky Scroll Section",
  "settings": [],
  "presets": [
    {
      "name": "Sticky Scroll Section",
      "category": "Product"
    }
  ]
}
{% endschema %}
