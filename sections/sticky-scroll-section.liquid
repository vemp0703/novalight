{% if product.metafields.custom.sticky_and_scroll_section != blank %}
{% assign section_items = product.metafields.custom.sticky_and_scroll_section.value %}

<section class="product-sticky-scroll-section mt-12">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 relative">

    <!-- Left sticky image -->
    <div class="sticky-image">
      {% if section_items.primary_image != blank %}
        <img src="{{ section_items.primary_image | img_url: '800x' }}" 
             alt="{{ section_items.heading }}" 
             class="w-full h-auto rounded-xl shadow-lg">
      {% endif %}
    </div>

    <!-- Right scroll content -->
    <div class="scroll-content space-y-10">

      <!-- Section Heading -->
      {% if section_items.heading != blank %}
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 leading-tight">{{ section_items.heading }}</h2>
      {% endif %}
      {% if section_items.sub_heading != blank %}
        <p class="text-gray-600 text-base lg:text-lg">{{ section_items.sub_heading }}</p>
      {% endif %}

      <!-- Scrollable Items -->
      <div class="space-y-8">
        {% for item in section_items.section_items.value %}
          <div class="scroll-item flex items-start space-x-4 opacity-0 transform translate-y-6">

            <!-- Icon / Numeric -->
            <div class="flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center"
                 style="background: {{ item.gradient }};">
              {% if item.icon != blank %}
                <img src="{{ item.icon | img_url: '48x48' }}" alt="" class="w-6 h-6">
              {% elsif item.numeric != blank %}
                <span class="text-white font-bold text-lg">{{ item.numeric }}</span>
              {% endif %}
            </div>

            <!-- Step content -->
            <div>
              {% if item.heading != blank %}
                <h3 class="text-xl font-semibold text-gray-800">{{ item.heading }}</h3>
              {% endif %}
              {% if item.content != blank %}
                <p class="text-gray-600 mt-1">{{ item.content }}</p>
              {% endif %}
            </div>

          </div>
        {% endfor %}
      </div>

    </div>

  </div>
</section>

<style>
/* Sticky image for large screens */
@media (min-width: 1024px) {
  .sticky-image {
    position: sticky;
    top: 6rem; /* adjust for header */
  }
}

/* Initial scroll item state */
.scroll-item {
  transition: all 0.7s ease-out;
  opacity: 0;
  transform: translateY(30px);
}
</style>

<!-- GSAP + ScrollTrigger -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.14.0/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.14.0/ScrollTrigger.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Pin left image
  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector('.product-sticky-scroll-section');
  const stickyImage = section.querySelector('.sticky-image');

  ScrollTrigger.create({
    trigger: section,
    start: "top top",
    end: "bottom bottom",
    pin: stickyImage,
    pinSpacing: false
  });

  // Animate scroll items
  gsap.utils.toArray('.scroll-item').forEach(item => {
    gsap.fromTo(item, 
      { opacity: 0, y: 30 }, 
      {
        opacity: 1,
        y: 0,
        scrollTrigger: {
          trigger: item,
          start: "top 80%",
          end: "bottom 60%",
          toggleActions: "play none none none"
        }
      });
  });
});
</script>

{% endif %}
