{% comment %}
  Section: Sticky and Scroll Section
  Metaobject: custom.sticky_and_scroll_section
{% endcomment %}

<section class="sticky-scroll-section">
  {% assign section_data = shop.metaobjects.custom.sticky_and_scroll_section.value %}

  {{ section_data |json }}
  
  {% if section_data and section_data.section_items %}
    {% for item in section_data.section_items %}
      <div class="sticky-scroll-item">
        <!-- Left Image (sticky on desktop) -->
        {% if item.primary_image %}
          <div class="sticky-scroll-image">
            <img src="{{ item.primary_image | img_url: '600x' }}" alt="{{ item.heading }}">
          </div>
        {% endif %}

        <!-- Right Content -->
        <div class="sticky-scroll-content">
          {% if item.heading %}
            <h2 class="sticky-scroll-heading">{{ item.heading }}</h2>
          {% endif %}

          {% if item.sub_heading %}
            <p class="sticky-scroll-subheading">{{ item.sub_heading }}</p>
          {% endif %}

          {% if item.items %}
            <div class="sticky-scroll-list">
              {% for list_item in item.items %}
                <p class="sticky-scroll-list-item">{{ list_item }}</p>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  {% endif %}
</section>

<style>
/* Section wrapper */
.sticky-scroll-section {
  display: flex;
  flex-direction: column;
  gap: 4rem;
  padding: 2rem;
}

/* Each item wrapper */
.sticky-scroll-item {
  display: flex;
  gap: 2rem;
  align-items: flex-start;
  flex-wrap: wrap;
}

/* Left image */
.sticky-scroll-image {
  flex: 0 0 300px;
  position: sticky;
  top: 2rem; /* spacing from top */
  height: max-content;
}

.sticky-scroll-image img {
  width: 100%;
  height: auto;
  object-fit: cover;
  border-radius: 1rem;
}

/* Right content */
.sticky-scroll-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* Heading and subheading */
.sticky-scroll-heading {
  font-size: 1.8rem;
  margin-bottom: 0.5rem;
}
.sticky-scroll-subheading {
  font-size: 1.2rem;
  color: #555;
  margin-bottom: 1rem;
}

/* Scrollable items list */
.sticky-scroll-list {
  max-height: 300px; /* adjust as needed */
  overflow-y: auto;
  padding-right: 0.5rem;
  border-left: 2px solid #eee;
  padding-left: 1rem;
}

/* Each item in the list */
.sticky-scroll-list-item {
  margin-bottom: 0.5rem;
  line-height: 1.5;
}

/* Optional: scrollbar styling */
.sticky-scroll-list::-webkit-scrollbar {
  width: 8px;
}
.sticky-scroll-list::-webkit-scrollbar-thumb {
  background-color: rgba(0,0,0,0.2);
  border-radius: 4px;
}

/* Responsive Styles */
@media (max-width: 1024px) {
  .sticky-scroll-item {
    flex-direction: column;
    align-items: center;
  }
  .sticky-scroll-image {
    position: relative; /* remove sticky on smaller screens */
    top: 0;
    width: 100%;
    max-width: 400px;
    margin-bottom: 1.5rem;
  }
  .sticky-scroll-content {
    width: 100%;
  }
  .sticky-scroll-list {
    max-height: 200px;
  }
}

@media (max-width: 600px) {
  .sticky-scroll-heading {
    font-size: 1.5rem;
  }
  .sticky-scroll-subheading {
    font-size: 1rem;
  }
  .sticky-scroll-list {
    max-height: 150px;
    border-left: none;
    padding-left: 0;
  }
}
</style>

{% schema %}
{
  "name": "Sticky Scroll Section",
  "settings": [
    {
      "type": "text",
      "id": "custom_heading",
      "label": "Optional Heading Above Section",
      "default": "Your Section Heading"
    }
  ],
  "presets": [
    {
      "name": "Sticky Scroll Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}
