{% if product.metafields.custom.sticky_and_scroll_section != blank %}
{% assign section_items = product.metafields.custom.sticky_and_scroll_section.value %}

<section class="pinned-scroll-section">

  <!-- Creates scroll duration -->
  <div class="pin-spacer">

    <!-- Pinned container -->
    <div class="pin-container">

      <div class="pin-layout">

        <!-- LEFT : IMAGE -->
        <div class="pin-image">
          {% if section_items.primary_image != blank %}
            <img
              src="{{ section_items.primary_image | img_url: '800x' }}"
              alt="{{ section_items.heading }}">
          {% endif %}
        </div>

        <!-- RIGHT : SCROLL CONTENT -->
        <div class="pin-scroll">

          {% if section_items.heading != blank %}
            <h2 class="pin-heading">{{ section_items.heading }}</h2>
          {% endif %}

          {% if section_items.sub_heading != blank %}
            <p class="pin-subheading">{{ section_items.sub_heading }}</p>
          {% endif %}

          {% for item in section_items.section_items.value %}
            <div class="pin-item">
              <div class="pin-icon" style="background: {{ item.gradient }};">
                {{ item.numeric }}
              </div>
              <div class="pin-text">
                <h3>{{ item.heading }}</h3>
                <p>{{ item.content }}</p>
              </div>
            </div>
          {% endfor %}

        </div>

      </div>
    </div>

  </div>
</section>

<style>
/* =====================================================
   SHOPIFY & GLOBAL FIX
===================================================== */
.pinned-scroll-section {
  width: 100%;
  max-width: 100vw;
  overflow: visible !important;
}

.pinned-scroll-section * {
  box-sizing: border-box;
}
.product-faq {
    background: #F3F3F3 !important;
}
.faq-icon {
    background: #f3f3f3 !important;
}
.faq-item.active .faq-icon {
    color: #000000 !important;
}
.product-tab.active {
    box-shadow: 0 8px 20px rgb(203 216 207 / 66%) !important;
}
.product-feature-item {
    background: #789f901c !important;
    border: 1px solid #789f90 !important;
}

.pin-icon {
    background: #527567 !important;
}


/* =====================================================
   SCROLL DURATION
===================================================== */
.pin-spacer {
  height: 220vh; /* controls pin duration */
}

/* =====================================================
   PINNED CONTAINER
===================================================== */
.pin-container {
  position: sticky;
  top: 0;
  height: 100vh;
  display: flex;
  align-items: center;
  background: #fff;
}

/* =====================================================
   LAYOUT
===================================================== */
.pin-layout {
  display: flex;
  gap: 48px;
  max-width: 1200px;
  margin: auto;
  padding: 0 24px;
  align-items: center;
}

/* =====================================================
   LEFT IMAGE
===================================================== */
.pin-image {
  flex: 0 0 50%;
}

.pin-image img {
  width: 100%;
  border-radius: 18px;
  display: block;
}

/* =====================================================
   RIGHT SCROLL AREA
===================================================== */
.pin-scroll {
  flex: 0 0 50%;
  max-height: 70vh;
  overflow-y: auto;
  padding-right: 12px;

  /* hide scrollbar */
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.pin-scroll::-webkit-scrollbar {
  display: none;
}

/* =====================================================
   CONTENT STYLES
===================================================== */
.pin-heading {
  font-size: 32px;
  font-weight: 700;
  margin-bottom: 10px;
}

.pin-subheading {
  font-size: 16px;
  color: #666;
  margin-bottom: 32px;
}

.pin-item {
  display: flex;
  gap: 16px;
  margin-bottom: 28px;
}

.pin-icon {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  color: #fff;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.pin-text h3 {
  margin: 0 0 4px;
  font-size: 18px;
}

.pin-text p {
  margin: 0;
  font-size: 15px;
  color: #666;
}

/* =====================================================
   TABLET (≤1024px)
===================================================== */
@media (max-width: 1024px) {
  .pin-spacer {
    height: auto;
  }

  .pin-container {
    position: relative;
    height: auto;
  }

  .pin-layout {
    flex-direction: column;
  }

  .pin-image,
  .pin-scroll {
    flex: 0 0 100%;
    max-height: none;
    overflow: visible;
  }
}

/* =====================================================
   MOBILE (≤640px)
===================================================== */
@media (max-width: 640px) {
  .pin-heading {
    font-size: 24px;
  }

  .pin-layout {
    padding: 0 16px;
  }

  .pin-item {
    gap: 12px;
  }

  .pin-icon {
    width: 36px;
    height: 36px;
    font-size: 14px;
  }

  .product-faq {
    padding: 20px 20px !important;
    background: #F3F3F3 !important;
}
div#shopify-section-template--17720416829527__sticky_scroll_section_7YyDeH {
    padding-top: 50px;
}

}


</style>

{% endif %}
