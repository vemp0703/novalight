{% comment %}
Product Sticky & Scroll Section
- Uses product metafield: custom.sticky_and_scroll_section
- Each metaobject should have:
  - primary_image
  - heading
  - sub_heading
  - section_items (list of items with icon, heading, number)
{% endcomment %}

<section class="sticky-scroll-section-wrapper">
  {% assign sticky_sections = product.metafields.custom.sticky_and_scroll_section.value %}
  {% if sticky_sections != blank %}
    {{ sticky_sections.heading }}
    {{ sticky_sections.sub_heading }}
    {% for section_item in sticky_sections %}

      <div class="sticky-scroll-section">
        <div class="sticky-scroll-wrapper">

          <!-- Left Image (Sticky) -->
          {% if section_item.metafields.primary_image.value != blank %}
            <div class="sticky-image">
              <img src="{{ section_item.primary_image | img_url: '800x' }}" alt="{{ section_item.metafields.heading.value }}">
            </div>
          {% endif %}

          <!-- Right Content (Scrollable) -->
          <div class="scroll-content">
            {% if section_item.metafields.heading.value != blank %}
              <h2>{{ section_item.metafields.heading.value }}</h2>
            {% endif %}
            {% if section_item.metafields.sub_heading.value != blank %}
              <p>{{ section_item.metafields.sub_heading.value }}</p>
            {% endif %}

            {% if section_item.metafields.section_items.value != blank %}
              <div class="items-list">
                {% assign items = section_item.metafields.section_items.value %}
                {% for item in items %}
                  <div class="item">
                    {% if item.icon != blank %}
                      <img src="{{ item.icon | img_url: '100x' }}" alt="{{ item.heading }}">
                    {% endif %}
                    {% if item.heading != blank %}
                      <h3>{{ item.heading }}</h3>
                    {% endif %}
                    {% if item.number != blank %}
                      <p>{{ item.number }}</p>
                    {% endif %}
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          </div>

        </div>
      </div>

    {% endfor %}
  {% endif %}
</section>

<style>
/* Sticky Scroll Section Styles */
.sticky-scroll-section-wrapper {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 50px;
  padding: 20px;
}

.sticky-scroll-section {
  display: flex;
  justify-content: center;
}

.sticky-scroll-wrapper {
  display: flex;
  gap: 40px;
  max-width: 1200px;
  width: 100%;
}

.sticky-image {
  flex: 0 0 45%;
  position: sticky;
  top: 100px;
}

.sticky-image img {
  width: 100%;
  height: auto;
  object-fit: cover;
  border-radius: 12px;
}

.scroll-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.items-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.item {
  display: flex;
  align-items: center;
  gap: 15px;
}

.item img {
  width: 50px;
  height: 50px;
  object-fit: contain;
}

.item h3 {
  margin: 0;
  font-size: 18px;
}

.item p {
  margin: 0;
  font-size: 16px;
}

/* Responsive */
@media screen and (max-width: 1024px) {
  .sticky-scroll-wrapper {
    flex-direction: column;
  }
  .sticky-image {
    position: relative;
    top: auto;
    width: 100%;
  }
}
</style>
