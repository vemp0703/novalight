{% if product.metafields.custom.sticky_and_scroll_section != blank %}
{% assign section_items = product.metafields.custom.sticky_and_scroll_section.value %}

<section class="pinned-scroll-section">

  <!-- This creates scroll space -->
  <div class="pin-spacer">

    <!-- This stays pinned -->
    <div class="pin-container">

      <div class="pin-layout">

        <!-- LEFT (STICKY IMAGE) -->
        <div class="pin-image">
          {% if section_items.primary_image != blank %}
            <img
              src="{{ section_items.primary_image | img_url: '800x' }}"
              alt="{{ section_items.heading }}">
          {% endif %}
        </div>

        <!-- RIGHT (SCROLLABLE CONTENT) -->
        <div class="pin-scroll">

          {% if section_items.heading != blank %}
            <h2>{{ section_items.heading }}</h2>
          {% endif %}

          {% if section_items.sub_heading != blank %}
            <p>{{ section_items.sub_heading }}</p>
          {% endif %}

          {% for item in section_items.section_items.value %}
            <div class="pin-item">
              <div class="pin-icon" style="background: {{ item.gradient }};">
                {{ item.numeric }}
              </div>
              <div>
                <h3>{{ item.heading }}</h3>
                <p>{{ item.content }}</p>
              </div>
            </div>
          {% endfor %}

        </div>

      </div>
    </div>

  </div>
</section>

<style>
/* ===============================
   CRITICAL SHOPIFY FIX
================================ */
.pinned-scroll-section {
  width: 100%;
  overflow: visible !important;
}

/* ===============================
   SCROLL SPACE CREATOR
================================ */
.pin-spacer {
  height: 200vh; /* 🔥 controls how long section stays */
  position: relative;
}

/* ===============================
   PINNED CONTAINER
================================ */
.pin-container {
  position: sticky;
  top: 0;
  height: 100vh;
  display: flex;
  align-items: center;
  background: #fff;
}

/* ===============================
   TWO COLUMN LAYOUT
================================ */
.pin-layout {
  display: flex;
  gap: 48px;
  max-width: 1200px;
  margin: auto;
  padding: 0 24px;
}

/* ===============================
   LEFT IMAGE
================================ */
.pin-image {
  flex: 0 0 50%;
}

.pin-image img {
  width: 100%;
  border-radius: 18px;
}

/* ===============================
   RIGHT SCROLL
================================ */
.pin-scroll {
  flex: 0 0 50%;
  max-height: 70vh;
  overflow-y: auto;
  padding-right: 12px;
}

/* ===============================
   CONTENT
================================ */
.pin-item {
  display: flex;
  gap: 16px;
  margin-bottom: 28px;
}

.pin-icon {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  color: #fff;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===============================
   MOBILE FALLBACK
================================ */
@media (max-width: 1024px) {
  .pin-spacer {
    height: auto;
  }

  .pin-container {
    position: relative;
    height: auto;
  }

  .pin-layout {
    flex-direction: column;
  }

  .pin-scroll {
    max-height: none;
    overflow: visible;
  }
}
</style>

{% endif %}
