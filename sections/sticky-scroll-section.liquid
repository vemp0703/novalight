{% if product.metafields.custom.sticky_and_scroll_section != blank %}
{% assign section_items = product.metafields.custom.sticky_and_scroll_section.value %}

<section class="product-sticky-scroll-section">
  <div class="sticky-wrapper">

    <!-- LEFT -->
    <div class="sticky-image">
      {% if section_items.primary_image != blank %}
        <img src="{{ section_items.primary_image | img_url: '800x' }}"
             alt="{{ section_items.heading }}">
      {% endif %}
    </div>

    <!-- RIGHT -->
    <div class="scroll-content">

      {% if section_items.heading != blank %}
        <h2>{{ section_items.heading }}</h2>
      {% endif %}

      {% for item in section_items.section_items.value %}
        <div class="scroll-item">
          <h3>{{ item.heading }}</h3>
          <p>{{ item.content }}</p>
        </div>
      {% endfor %}

    </div>

  </div>
</section>

<style>
/* 🔑 CRITICAL FIX */
.product-sticky-scroll-section {
  position: relative;
  overflow: visible !important;
}

/* Two columns */
.sticky-wrapper {
  display: flex;
  gap: 48px;
  max-width: 1200px;
  margin: auto;
}

/* Sticky column */
.sticky-image {
  width: 50%;
  position: sticky;
  top: 120px;
  align-self: flex-start;
}

.sticky-image img {
  width: 100%;
  border-radius: 16px;
}

/* Scroll column */
.scroll-content {
  width: 50%;
  height: 70vh;
  overflow-y: auto;
  padding-right: 12px;
}

/* Items */
.scroll-item {
  margin-bottom: 32px;
}

/* Mobile */
@media (max-width: 1024px) {
  .sticky-wrapper {
    flex-direction: column;
  }
  .scroll-content {
    height: auto;
    overflow: visible;
  }
}
</style>

{% endif %}
