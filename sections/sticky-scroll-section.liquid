{% comment %}
Sticky & Scroll Section (Block Version)
- Metaobject: custom.sticky_and_scroll_section
- Each block can have:
  - Primary Image
  - Heading
  - Sub Heading
  - Section Items (list of items)
{% endcomment %}

<section class="sticky-scroll-section-wrapper">
  {% if section.blocks.size > 0 %}
    {% for block in section.blocks %}
      {% assign section_item = block.settings.section_item %}

      <div class="sticky-scroll-section">
        <div class="sticky-scroll-wrapper">

          <!-- Left Image (Sticky) -->
          {% if section_item.primary_image %}
            <div class="sticky-image">
              <img src="{{ section_item.primary_image | img_url: '800x' }}" alt="{{ section_item.heading }}">
            </div>
          {% endif %}

          <!-- Right Content (Scrollable) -->
          <div class="scroll-content">
            {% if section_item.heading %}
              <h2>{{ section_item.heading }}</h2>
            {% endif %}
            {% if section_item.sub_heading %}
              <p>{{ section_item.sub_heading }}</p>
            {% endif %}

            {% if section_item.section_items %}
              <div class="items-list">
                {% for item in section_item.section_items %}
                  <div class="item">
                    {% if item.icon %}
                      <img src="{{ item.icon | img_url: '100x' }}" alt="{{ item.heading }}">
                    {% endif %}
                    {% if item.heading %}
                      <h3>{{ item.heading }}</h3>
                    {% endif %}
                    {% if item.number %}
                      <p>{{ item.number }}</p>
                    {% endif %}
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          </div>

        </div>
      </div>
    {% endfor %}
  {% endif %}
</section>

<style>
.sticky-scroll-section-wrapper {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 50px;
  padding: 20px;
}

.sticky-scroll-section {
  display: flex;
  justify-content: center;
}

.sticky-scroll-wrapper {
  display: flex;
  gap: 40px;
  max-width: 1200px;
  width: 100%;
}

.sticky-image {
  flex: 0 0 45%;
  position: sticky;
  top: 100px;
}

.sticky-image img {
  width: 100%;
  height: auto;
  object-fit: cover;
  border-radius: 12px;
}

.scroll-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.items-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.item {
  display: flex;
  align-items: center;
  gap: 15px;
}

.item img {
  width: 50px;
  height: 50px;
  object-fit: contain;
}

.item h3 {
  margin: 0;
  font-size: 18px;
}

.item p {
  margin: 0;
  font-size: 16px;
}

@media screen and (max-width: 1024px) {
  .sticky-scroll-wrapper {
    flex-direction: column;
  }
  .sticky-image {
    position: relative;
    top: auto;
    width: 100%;
  }
}
</style>

