{% if product.metafields.custom.sticky_and_scroll_section != blank %}
{% assign section_items = product.metafields.custom.sticky_and_scroll_section.value %}

<section class="product-sticky-scroll-section mt-12">
  <div class="lg:flex lg:gap-12 lg:h-[80vh]">

    <!-- Left sticky image -->
    <div class="lg:w-1/2 lg:sticky lg:top-24 self-start">
      {% if section_items.primary_image != blank %}
        <img src="{{ section_items.primary_image | img_url: '800x' }}" 
             alt="{{ section_items.heading }}" 
             class="w-full h-auto rounded-xl shadow-lg">
      {% endif %}
    </div>

    <!-- Right scrollable content -->
    <div class="lg:w-1/2 lg:max-h-[80vh] lg:overflow-y-auto space-y-10 pr-4">
      
      <!-- Section Heading -->
      {% if section_items.heading != blank %}
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 leading-tight">{{ section_items.heading }}</h2>
      {% endif %}
      {% if section_items.sub_heading != blank %}
        <p class="text-gray-600 text-base lg:text-lg">{{ section_items.sub_heading }}</p>
      {% endif %}

      <!-- Scrollable Steps -->
      <div class="space-y-8">
        {% for item in section_items.section_items.value %}
          <div class="scroll-item flex items-start space-x-4 opacity-0 transform translate-y-6 transition-all duration-700 ease-out">

            <!-- Icon / Numeric -->
            <div class="flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center"
                 style="background: {{ item.gradient }};">
              {% if item.icon != blank %}
                <img src="{{ item.icon | img_url: '48x48' }}" alt="" class="w-6 h-6">
              {% elsif item.numeric != blank %}
                <span class="text-white font-bold text-lg">{{ item.numeric }}</span>
              {% endif %}
            </div>

            <!-- Step content -->
            <div>
              {% if item.heading != blank %}
                <h3 class="text-xl font-semibold text-gray-800">{{ item.heading }}</h3>
              {% endif %}
              {% if item.content != blank %}
                <p class="text-gray-600 mt-1">{{ item.content }}</p>
              {% endif %}
            </div>

          </div>
        {% endfor %}
      </div>

    </div>

  </div>
</section>

<style>
/* Sticky image for large screens */
@media (min-width: 1024px) {
  .product-sticky-scroll-section .lg\:sticky {
    top: 6rem; /* Adjust if your header is taller */
  }
}

/* Fade-in animation for scroll items */
.scroll-item {
  transition: all 0.7s ease-out;
}
.scroll-item.opacity-100 {
  opacity: 1 !important;
  transform: translateY(0) !important;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const items = document.querySelectorAll('.scroll-item');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('opacity-100');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.2 });

  items.forEach(item => observer.observe(item));
});
</script>

{% endif %}
