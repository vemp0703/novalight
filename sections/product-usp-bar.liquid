{% style %}
    .product-usp {
        padding: 16px 0;
    }

    .product-usp__wrapper {
        display: flex;
        gap: 16px;
        border-radius: 12px;
        padding: 14px;
        width: 97%;
        margin: auto;
    }

    .product-usp__item {
        flex: 1;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 15px;
    }

    .product-usp__icon {
        width: 24px;
        height: 24px;
        flex-shrink: 0;
    }

    .product-usp__icon img {
        width: 100%;
        height: 100%;
    }

    .product-usp__content h4 {
        color: #0F172B;
        font-family: Jost;
        font-size: 17px;
        font-style: normal;
        font-weight: 600;
        line-height: 28.9px;
        margin:auto; 
    }

    .product-usp__content p {
        color: #45556C;
        font-family: Jost;
        font-size: 17px;
        font-style: normal;
        font-weight: 400;
        line-height: 28.9px; /* 170% */
        margin:auto;
    }

    @media (max-width: 768px) {
        .product-usp__wrapper {
            flex-direction: column;
        }
    }
}
{% endstyle %}

<div class="product-usp page-width">
  <div class="product-usp__wrapper">
    {% for block in section.blocks %}
      <div class="product-usp__item" {{ block.shopify_attributes }}>
        {% if block.settings.icon != blank %}
          <div class="product-usp__icon">
            <img
              src="{{ block.settings.icon | image_url: width: 24 }}"
              alt=""
              height="24"
              width="24"
              loading="lazy"
            >
          </div>
        {% endif %}

        <div class="product-usp__content">
          <h4>{{ block.settings.title }}</h4>
          <p>{{ block.settings.text }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Product USP Bar",
  "settings": [],
  "blocks": [
    {
      "type": "usp",
      "name": "USP Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free Express Shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Sub text",
          "default": "Arrives in 2–3 business days"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product USP Bar",
      "blocks": [
        { "type": "usp" },
        { "type": "usp" },
        { "type": "usp" }
      ]
    }
  ]
}
{% endschema %}
