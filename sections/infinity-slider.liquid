{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap');
  
  .section-{{ section.id }} .slider-wrapper.color-black .slide {
    color: {{ section.settings.text_color }} !important;
  }
  .infinity-slider-section.section-{{ section.id }} {
    background: #DDDDDD;
    padding: 40px 0;
}
  .section-{{ section.id }} .slider-wrapper {
    width: 100%;
    overflow: hidden;
  }
  
  .section-{{ section.id }} .slider-track {
    display: flex;
    width: calc(250px * {{ section.blocks.size | times: 4 }});
    animation: scroll-{{ section.id }} {{ section.settings.slider_speed }}s linear infinite;
  }
  
  .section-{{ section.id }} .slider-wrapper:hover .slider-track {
    animation-play-state: paused;
  }
  
  .section-{{ section.id }} .slide {
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.text_color }};
    font-weight: 400;
    font-family: "Lato", sans-serif;
    font-size: {{ section.settings.font_size }}px;
    gap: 8px;
    white-space: nowrap;
    min-width: max-content;
    padding: 0 20px;
  }
  
  .section-{{ section.id }} .slide img {
    width: {{ section.settings.icon_size }}px !important;
    height: {{ section.settings.icon_size }}px !important;
    object-fit: contain;
  }
  
  .section-{{ section.id }} .slide-icon-svg {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .section-{{ section.id }} .slide-icon-svg svg {
    width: 100%;
    height: 100%;
  }
  
  @keyframes scroll-{{ section.id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  
  /* Section title styling */
  .section-{{ section.id }} .heading-wrapper {
    text-align: center;
    margin-bottom: 30px;
  }
  
  .section-{{ section.id }} .section-title {
    color: {{ section.settings.heading_color }};
    /* font-family: "Lato", sans-serif; */
    font-size: {{ section.settings.heading_size }}px;
    margin: 0;
  }
  
  /* Responsive styles */
  @media (max-width: 768px) {
    .section-{{ section.id }} .slider-track {
      width: calc(200px * {{ section.blocks.size | times: 4 }});
    }
    
    .section-{{ section.id }} .slide {
      min-width: 200px;
      font-size: {{ section.settings.font_size | times: 0.85 }}px;
    }
    
    .section-{{ section.id }} .section-title {
      font-size: {{ section.settings.heading_size | times: 0.8 }}px;
    }
  }
  
  @media (max-width: 480px) {
    .section-{{ section.id }} .slider-track {
      width: calc(180px * {{ section.blocks.size | times: 4 }});
    }
    
    .section-{{ section.id }} .slide {
      min-width: max-content;
      font-size: {{ section.settings.font_size | times: 0.75 }}px;
    }
    
    .section-{{ section.id }} .section-title {
      font-size: {{ section.settings.heading_size | times: 0.7 }}px;
    }
  }
{% endstyle %}

<div class="infinity-slider-section section-{{ section.id }}">
  {% if section.settings.heading != blank %}
    <div class="heading-wrapper">
      <h2 class="section-title">{{ section.settings.heading }}</h2>
    </div>
  {% endif %}
  
  <div class="slider-wrapper {% if section.settings.inverse_colors %}color-black{% endif %}">
    <div class="slider-track">
      {% comment %} Each block will be repeated 4 times for seamless animation {% endcomment %}
      {% for i in (1..4) %}
        {% for block in section.blocks %}
          <div class="slide" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
              <img src="{{ block.settings.icon | img_url: '100x' }}" 
                   alt="{{ block.settings.text | escape }}"
                   width="{{ section.settings.icon_size }}"
                   height="{{ section.settings.icon_size }}"
                   loading="lazy">
            {% elsif block.settings.icon_svg != blank %}
              <div class="slide-icon-svg">{{ block.settings.icon_svg }}</div>
            {% endif %}
            <span class="slide-text">{{ block.settings.text }}</span>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Infinity Slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Our Features"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Heading Size",
      "default": 32
    },
    {
      "type": "range",
      "id": "slider_speed",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Slider Speed",
      "default": 25,
      "info": "Animation duration in seconds"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Text Font Size",
      "default": 18
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#303030"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Icon Size",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "inverse_colors",
      "label": "Dark Background Mode",
      "default": false,
      "info": "Enable if section has dark background"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Slide Text",
          "default": "Feature Name"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image",
          "info": "Recommended size: 50x50px"
        },
        {
          "type": "textarea",
          "id": "icon_svg",
          "label": "Or SVG Icon Code",
          "info": "Paste SVG code here as alternative to image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Infinity Slider",
      "category": "Sliders",
      "settings": {
        "heading": "Why Choose Us",
        "slider_speed": 25,
        "font_size": 18,
        "text_color": "#303030"
      },
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "text": "Collagen Boost"
          }
        },
        {
          "type": "slide",
          "settings": {
            "text": "Acne Control"
          }
        },
        {
          "type": "slide",
          "settings": {
            "text": "Tone Correction"
          }
        },
        {
          "type": "slide",
          "settings": {
            "text": "Redness Relief"
          }
        },
        {
          "type": "slide",
          "settings": {
            "text": "Comfort Fit"
          }
        },
        {
          "type": "slide",
          "settings": {
            "text": "Custom Modes"
          }
        }
      ]
    }
  ]
}
{% endschema %}