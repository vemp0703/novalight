{{ 'infinity-slider.css' | asset_url | stylesheet_tag }}

{% style %}
  :root {
    --slider-speed: {{ section.settings.slider_speed }}s;
    --slide-font-size: {{ section.settings.font_size }}px;
    --slide-color: {{ section.settings.text_color }};
    --heading-color: {{ section.settings.heading_color }};
  }
{% endstyle %}

<div class="infinity-slider-section">
  {% if section.settings.heading != blank %}
    <div class="heading-wrapper">
      <h2 class="section-title">{{ section.settings.heading }}</h2>
    </div>
  {% endif %}
  
  <div class="slider-wrapper {% if section.settings.inverse_colors %}color-inverse{% endif %}">
    <div class="slider-track">
      {% for block in section.blocks %}
        {% for i in (1..4) %}
          <div class="slide" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
              <img src="{{ block.settings.icon | img_url: '50x' }}" 
                   alt="{{ block.settings.text | escape }}"
                   width="24"
                   height="24"
                   loading="lazy">
            {% elsif block.settings.icon_svg != blank %}
              <div class="slide-icon-svg">{{ block.settings.icon_svg }}</div>
            {% endif %}
            <span class="slide-text">{{ block.settings.text }}</span>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</div>
<script>
    // infinity-slider.js
class InfinitySlider extends HTMLElement {
  constructor() {
    super();
    
    // Ensure smooth animation even when tab is inactive
    document.addEventListener('visibilitychange', () => {
      const sliderTrack = this.querySelector('.slider-track');
      if (document.hidden) {
        sliderTrack.style.animationPlayState = 'paused';
      } else {
        sliderTrack.style.animationPlayState = 'running';
      }
    });
  }
}

if (!customElements.get('infinity-slider')) {
  customElements.define('infinity-slider', InfinitySlider);
}
</script>

{% schema %}
{
  "name": "Infinity Slider",
  "tag": "section",
  "class": "section-infinity-slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Our Features"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "slider_speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Slider Speed",
      "default": 25
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Font Size",
      "default": 18
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#303030"
    },
    {
      "type": "checkbox",
      "id": "inverse_colors",
      "label": "Inverse Colors",
      "default": false,
      "info": "Enable for dark backgrounds"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Feature Name"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "textarea",
          "id": "icon_svg",
          "label": "SVG Icon Code",
          "info": "Alternative to image. Paste SVG code here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Infinity Slider",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "text": "Collagen Boost"
          }
        },
        {
          "type": "slide",
          "settings": {
            "text": "Acne Control"
          }
        },
        {
          "type": "slide",
          "settings": {
            "text": "Tone Correction"
          }
        },
        {
          "type": "slide",
          "settings": {
            "text": "Redness Relief"
          }
        }
      ]
    }
  ]
}
{% endschema %}