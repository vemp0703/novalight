{% style %}
 .product-highlights {
  margin-top: 40px;
}

.highlights-heading {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 16px;
}

.highlights-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 16px;
}

.highlight-card {
  border: 1px solid #e6eaf0;
  border-radius: 12px;
  padding: 20px;
  text-align: center;
  background: #fff;
}

.highlight-icon {
  margin-bottom: 12px;
}

.highlight-title {
    color: #0F172B;
    text-align: center;
    font-family: Marcellus;
    font-size: 20px;
    font-style: normal;
    font-weight: 400;
    line-height: 28px; /* 140% */
}

.highlight-desc {
    color: #45556C;
    text-align: center;
    font-family: Jost;
    font-size: 17px;
    font-style: normal;
    font-weight: 400;
    line-height: 28.9px; /* 170% */
}

{% endstyle %}


{% if product.metafields.custom.product_highlights != blank %}
  <div class="product-highlights page-width">

 <div class="highlights-grid">
      {% for highlight in product.metafields.custom.product_highlights.value %}
        <div class="highlight-card">

          {% if highlight.icon != blank %}
            <div class="highlight-icon">
              <img
                src="{{ highlight.icon | image_url: width: 64 }}"
                alt="{{ highlight.title | escape }}"
                width="32"
                height="32"
              >
            </div>
          {% endif %}

          {% if highlight.title != blank %}
            <h4 class="highlight-title">
              {{ highlight.title }}
            </h4>
          {% endif %}

          {% if highlight.description != blank %}
            <p class="highlight-desc">
              {{ highlight.description }}
            </p>
          {% endif %}

        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Product Highlights",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Product Specifications"
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        {
          "type": "metaobject",
          "id": "highlight",
          "label": "Product Highlight",
          "metaobject_type": "product_highlight"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Product Highlights"
    }
  ]
}
{% endschema %}
