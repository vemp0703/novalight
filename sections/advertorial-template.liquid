<style>

/* ===================================
   Typography
   =================================== */
h1, h2, h3 {
    font-family: inherit;
    line-height: 1.3;
    color: #0f172a;
    margin-bottom: 1rem;
}

h1 {
    font-size: 2rem;
}

h2 {
    font-size: 1.75rem;
}

h3 {
    font-size: 1.25rem;
}

p {
    margin-bottom: 1rem;
}

strong {
    font-weight: 600;
    color: #1e293b;
}

em {
    font-style: italic;
}

/* ===================================
   Layout Components
   =================================== */
.container {
    max-width: 95%;
    margin: 0 auto;
    padding: 0 1rem;
}

.section {
    margin-bottom: 4rem;
}

/* ===================================
   Hero Section
   =================================== */
.hero {
    background: linear-gradient(to bottom, #f8fafc, #ffffff);
    border-bottom: 1px solid #e2e8f0;
    padding: 3rem 0;
}

.hero-title {
    font-size: 2rem;
    line-height: 1.2;
    margin-bottom: 1.5rem;
    color: #0f172a;
}

.hero-subtitle {
    font-size: 1.125rem;
    color: #475569;
    max-width: 95%;
    line-height: 1.6;
}

/* ===================================
   Main Content
   =================================== */
.main-content {
    padding: 3rem 0;
}

.section-title {
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
    color: #0f172a;
}

.content {
    color: #475569;
}

.paragraph {
    color: #475569;
    line-height: 1.7;
    margin-bottom: 1rem;
}

.paragraph.italic {
    font-style: italic;
}

.paragraph.strong {
    font-weight: 600;
}

.paragraph.large {
    font-size: 1.125rem;
}

/* ===================================
   Section Variants
   =================================== */
.section-alt {
    background-color: #f8fafc;
    border-radius: 0.5rem;
    padding: 2rem;
}

.section-highlight {
    background: linear-gradient(to bottom right, #fef3c7, #fed7aa);
    border-radius: 0.5rem;
    padding: 2rem;
}

.section-purple {
    background: linear-gradient(to bottom right, #faf5ff, #fce7f3);
    border-radius: 0.5rem;
    padding: 2rem;
}

.section-divider {
    border-top: 2px solid #e2e8f0;
    padding-top: 3rem;
}

.section-final {
    background: linear-gradient(to bottom right, #f8fafc, #dbeafe);
    border: 2px solid #cbd5e1;
    border-radius: 0.5rem;
    padding: 2rem;
}

/* ===================================
   Lists
   =================================== */
.list {
    list-style: none;
    margin-bottom: 1.5rem;
}

.list-item {
    color: #475569;
    margin-bottom: 0.75rem;
    padding-left: 1.5rem;
    position: relative;
}

.list-item::before {
    content: "•";
    position: absolute;
    left: 0;
    color: #475569;
}

.list-numbered {
    list-style: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
}

.list-numbered .list-item::before {
    display: none;
}

.list-small {
    padding-left: 1rem;
}

.list-checkmark .list-item::before {
    content: "✓";
    color: #16a34a;
}

/* ===================================
   Timeline
   =================================== */
.timeline {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
}

.timeline-item {
    margin-bottom: 1.5rem;
}

.timeline-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: #0f172a;
    margin-bottom: 0.75rem;
}

/* ===================================
   Callouts
   =================================== */
.callout {
    padding: 1.5rem;
    border-radius: 0.5rem;
    margin-top: 1.5rem;
}

.callout-blue {
    background-color: #dbeafe;
    border-left: 4px solid #3b82f6;
}

.callout-title {
    font-weight: 600;
    color: #0f172a;
    margin-bottom: 0.5rem;
}

/* ===================================
   Options
   =================================== */
.options {
    margin-top: 1.5rem;
    margin-bottom: 2rem;
}

.option-item {
    margin-bottom: 1.5rem;
}

.option-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: #0f172a;
    margin-bottom: 0.5rem;
}

.option-featured {
    border: 2px solid #d97706;
    border-radius: 0.5rem;
    padding: 1.5rem;
    background-color: #ffffff;
}

.option-title-featured {
    color: #78350f;
}

/* ===================================
   Mechanism Steps
   =================================== */
.mechanism {
    margin-top: 1.5rem;
}

.mechanism-item {
    border-left: 4px solid;
    padding-left: 1.5rem;
    margin-bottom: 2rem;
}

.mechanism-red {
    border-color: #ef4444;
}

.mechanism-purple {
    border-color: #a855f7;
}

.mechanism-green {
    border-color: #22c55e;
}

.mechanism-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: #0f172a;
    margin-bottom: 0.75rem;
}

/* ===================================
   Testimonial
   =================================== */
.testimonial {
    background: linear-gradient(to right, #dbeafe, #e0e7ff);
    border: 1px solid #93c5fd;
    border-radius: 0.5rem;
    padding: 2rem;
}

/* ===================================
   Evidence
   =================================== */
.evidence {
    margin-bottom: 1.5rem;
}

/* ===================================
   Myth vs Fact
   =================================== */
.myth-fact-grid {
    margin-top: 1.5rem;
}

.myth-fact-item {
    border: 1px solid #e2e8f0;
    border-radius: 0.5rem;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
}

.myth-fact-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
}

.myth-fact-col {
    display: flex;
    flex-direction: column;
}

.myth-label {
    font-weight: 600;
    color: #dc2626;
    margin-bottom: 0.5rem;
    font-size: 1rem;
}

.fact-label {
    font-weight: 600;
    color: #16a34a;
    margin-bottom: 0.5rem;
    font-size: 1rem;
}

/* ===================================
   Tables
   =================================== */
.table-responsive {
    overflow-x: auto;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
}

.comparison-table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid #cbd5e1;
}

.comparison-table th,
.comparison-table td {
    border: 1px solid #cbd5e1;
    padding: 1rem;
    text-align: left;
}

.comparison-table thead {
    background-color: #f1f5f9;
}

.comparison-table th {
    font-weight: 600;
    color: #0f172a;
}

.comparison-table td {
    color: #475569;
}

.comparison-table tbody tr:nth-child(even) {
    background-color: #f8fafc;
}

.table-label {
    font-weight: 600;
    color: #0f172a;
}

/* ===================================
   Final Content
   =================================== */
.final-content {
    margin-top: 2rem;
}

.final-item {
    margin-bottom: 2rem;
}

.final-subtitle {
    font-size: 1.25rem;
    font-weight: 600;
    color: #0f172a;
    margin-bottom: 0.75rem;
}

/* ===================================
   CTA Section
   =================================== */
.cta {
    background: linear-gradient(to right, #2563eb, #4f46e5);
    border-radius: 0.5rem;
    padding: 3rem 2rem;
    text-align: center;
    color: #ffffff;
}

.cta-title {
    font-size: 1.75rem;
    color: #ffffff;
    margin-bottom: 1rem;
}

.cta-text {
    font-size: 1.125rem;
    color: #dbeafe;
    max-width: 42rem;
    margin: 0 auto 2rem;
}

.cta-button {
    background-color: #ffffff;
    color: #2563eb;
    padding: 1rem 2rem;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 1.125rem;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
}

.cta-button:hover {
    background-color: #dbeafe;
}

.cta-button:active {
    transform: translateY(1px);
}

/* ===================================
   Footer
   =================================== */
.footer {
    background-color: #0f172a;
    color: #cbd5e1;
    padding: 3rem 0;
}

.footer-content {
    text-align: center;
    margin-bottom: 1.5rem;
}

.footer-title {
    font-size: 1.5rem;
    color: #ffffff;
    margin-bottom: 0.5rem;
}

.footer-subtitle {
    color: #94a3b8;
    font-size: 0.875rem;
}

.footer-disclaimer {
    text-align: center;
    font-size: 0.875rem;
    color: #94a3b8;
    border-top: 1px solid #334155;
    padding-top: 1.5rem;
}

.disclaimer-text {
    margin-bottom: 0.5rem;
}

/* ===================================
   Responsive Design - Tablet
   =================================== */
@media (min-width: 640px) {
    .hero {
        padding: 4rem 0;
    }

    .hero-title {
        font-size: 2.5rem;
    }

    .hero-subtitle {
        font-size: 1.25rem;
    }

    .section-title {
        font-size: 2rem;
    }

    .section-alt,
    .section-highlight,
    .section-purple,
    .section-final {
        padding: 2.5rem;
    }

    .cta {
        padding: 3rem;
    }
}

/* ===================================
   Responsive Design - Desktop
   =================================== */
@media (min-width: 768px) {
    .hero {
        padding: 5rem 0;
    }

    .hero-title {
        font-size: 3rem;
    }

    .main-content {
        padding: 4rem 0;
    }

    .section {
        margin-bottom: 5rem;
    }

    .section-title {
        font-size: 2.25rem;
    }

    .myth-fact-row {
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .final-content {
        margin-top: 3rem;
    }

    .final-item {
        margin-bottom: 2.5rem;
    }
}

@media (min-width: 1024px) {
    .container {
        padding: 0 2rem;
    }

    .hero {
        padding: 6rem 0;
    }

    .hero-title {
        font-size: 3.5rem;
    }

    .cta-title {
        font-size: 2rem;
    }
}

/* ===================================
   Print Styles
   =================================== */
@media print {
    .cta-button {
        display: none;
    }

    .section {
        page-break-inside: avoid;
    }

    body {
        font-size: 12pt;
    }
}

/* ===================================
   Cross-Browser Compatibility
   =================================== */

/* Firefox */
@-moz-document url-prefix() {
    body {
        font-weight: normal;
    }
}

/* Safari */
@supports (-webkit-appearance: none) {
    .cta-button {
        -webkit-appearance: none;
    }
}

/* IE10+ */
@media screen and (-ms-high-contrast: active), (-ms-high-contrast: none) {
    .hero {
        background: #f8fafc;
    }
    
    .section-highlight {
        background: #fef3c7;
    }
    
    .section-purple {
        background: #faf5ff;
    }
    
    .section-final {
        background: #f8fafc;
    }
    
    .cta {
        background: #2563eb;
    }
}

/* ===================================
   Accessibility
   =================================== */
.cta-button:focus,
button:focus {
    outline: 2px solid #3b82f6;
    outline-offset: 2px;
}

/* Skip to main content link for screen readers */
.skip-to-main {
    position: absolute;
    left: -9999px;
    z-index: 999;
}

.skip-to-main:focus {
    left: 50%;
    transform: translateX(-50%);
    top: 10px;
    background: #2563eb;
    color: white;
    padding: 1rem;
    border-radius: 0.5rem;
}

/* High contrast mode support */
@media (prefers-contrast: high) {
    .hero {
        border-bottom: 2px solid #000;
    }
    
    .callout-blue {
        border-left-width: 6px;
    }
    
    .mechanism-item {
        border-left-width: 6px;
    }
}

/* Reduced motion support */
@media (prefers-reduced-motion: reduce) {
    * {
        animation: none !important;
        transition: none !important;
    }
}

/* Dark mode support (optional) */
@media (prefers-color-scheme: dark) {
    /* This is optional - can be enabled if dark mode is needed */
    /*
    body {
        background-color: #0f172a;
        color: #e2e8f0;
    }
    
    h1, h2, h3 {
        color: #f1f5f9;
    }
    */
}

/* ===================================
   Touch Device Optimizations
   =================================== */
@media (hover: none) and (pointer: coarse) {
    .cta-button {
        padding: 1.25rem 2.5rem;
        font-size: 1.25rem;
    }
    
    /* Increase tap targets for mobile */
    button {
        min-height: 44px;
        min-width: 44px;
    }
}

/* ===================================
   Loading States
   =================================== */
.cta-button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

/* ===================================
   Small Mobile Adjustments
   =================================== */
@media (max-width: 480px) {
    .hero-title {
        font-size: 1.75rem;
    }
    
    .section-title {
        font-size: 1.5rem;
    }
    
    .comparison-table {
        font-size: 0.875rem;
    }
    
    .comparison-table th,
    .comparison-table td {
        padding: 0.75rem;
    }
    
    .section-alt,
    .section-highlight,
    .section-purple,
    .section-final {
        padding: 1.5rem;
    }
    
    .cta {
        padding: 2rem 1.5rem;
    }
    
    .cta-title {
        font-size: 1.5rem;
    }
    
    .cta-text {
        font-size: 1rem;
    }
}

.advertorial-wrapper {
  max-width: 95%;
  margin: 0 auto;
  padding: 40px 20px;
  font-family: Georgia, serif;
  line-height: 1.8;
  color: #222;
}

.advertorial-meta {
  font-size: 14px;
  color: #777;
  margin-bottom: 20px;
}

.advertorial-wrapper h1 {
  font-size: 34px;
  margin-bottom: 10px;
}

.advertorial-wrapper h2 {
  font-size: 24px;
  margin-top: 40px;
}

.highlight-box {
  background: #f8f8f8;
  padding: 20px;
  border-left: 4px solid #000;
  margin: 30px 0;
}

.cta-button {
  display: block;
  text-align: center;
  background: #000;
  color: #fff;
  padding: 16px;
  text-decoration: none;
  font-weight: bold;
  border-radius: 6px;
  margin: 30px 0;
  transition: 0.3s ease;
}

.cta-button:hover {
  opacity: 0.85;
}

.testimonial {
  background: #fafafa;
  padding: 20px;
  margin-bottom: 20px;
  border-radius: 6px;
  font-size: 15px;
}

.product-box {
  background: #fff;
  border: 1px solid #eee;
  padding: 20px;
  text-align: center;
  margin: 40px 0;
}

.product-box img {
  max-width: 100%;
  margin-bottom: 15px;
}
</style>

<div class="advertorial-wrapper">

  <!-- Meta -->
  <div class="advertorial-meta">
    Sponsored • {{ section.settings.author_name }} • {{ "now" | date: "%B %d, %Y" }}
  </div>

  <!-- Headline -->
  <h1>{{ section.settings.headline }}</h1>
  <p><strong>{{ section.settings.subheadline }}</strong></p>

  <!-- Intro -->
  {{ section.settings.intro_text }}

  <!-- PAGE DESCRIPTION (IMPORTANT) -->
  <div class="page-description">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "Advertorial Template",
  "settings": [
    { "type": "text", "id": "author_name", "label": "Author Name", "default": "Health Editorial Team" },
    { "type": "text", "id": "headline", "label": "Headline" },
    { "type": "text", "id": "subheadline", "label": "Subheadline" },
    { "type": "richtext", "id": "intro_text", "label": "Intro Text" },
    { "type": "richtext", "id": "problem_text", "label": "Problem Text" },
    { "type": "richtext", "id": "research_text", "label": "Research Text" },
    { "type": "richtext", "id": "solution_text", "label": "Solution Text" },
    { "type": "richtext", "id": "benefits_text", "label": "Benefits Text" },
    { "type": "text", "id": "testimonial_1", "label": "Testimonial 1" },
    { "type": "text", "id": "testimonial_name_1", "label": "Testimonial 1 Name" },
    { "type": "text", "id": "testimonial_2", "label": "Testimonial 2" },
    { "type": "text", "id": "testimonial_name_2", "label": "Testimonial 2 Name" },
    { "type": "product", "id": "product", "label": "Select Product (Optional)" },
    { "type": "text", "id": "final_cta_text", "label": "Final CTA Text", "default": "Get Special Offer Now" },
    { "type": "url", "id": "final_cta_link", "label": "Final CTA Link" }
  ],
  "presets": [
    {
      "name": "Advertorial Page"
    }
  ]
}
{% endschema %}
