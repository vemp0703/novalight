<style>
.advertorial-wrapper {
  max-width: 760px;
  margin: 0 auto;
  padding: 40px 20px;
  font-family: Georgia, serif;
  line-height: 1.8;
  color: #222;
}

.advertorial-meta {
  font-size: 14px;
  color: #777;
  margin-bottom: 20px;
}

.advertorial-wrapper h1 {
  font-size: 34px;
  margin-bottom: 10px;
}

.advertorial-wrapper h2 {
  font-size: 24px;
  margin-top: 40px;
}

.highlight-box {
  background: #f8f8f8;
  padding: 20px;
  border-left: 4px solid #000;
  margin: 30px 0;
}

.cta-button {
  display: block;
  text-align: center;
  background: #000;
  color: #fff;
  padding: 16px;
  text-decoration: none;
  font-weight: bold;
  border-radius: 6px;
  margin: 30px 0;
  transition: 0.3s ease;
}

.cta-button:hover {
  opacity: 0.85;
}

.testimonial {
  background: #fafafa;
  padding: 20px;
  margin-bottom: 20px;
  border-radius: 6px;
  font-size: 15px;
}

.product-box {
  background: #fff;
  border: 1px solid #eee;
  padding: 20px;
  text-align: center;
  margin: 40px 0;
}

.product-box img {
  max-width: 100%;
  margin-bottom: 15px;
}
</style>

<div class="advertorial-wrapper">

  <!-- Meta -->
  <div class="advertorial-meta">
    Sponsored • {{ section.settings.author_name }} • {{ "now" | date: "%B %d, %Y" }}
  </div>

  <!-- Headline -->
  <h1>{{ section.settings.headline }}</h1>
  <p><strong>{{ section.settings.subheadline }}</strong></p>

  <!-- Intro -->
  {{ section.settings.intro_text }}

  <!-- PAGE DESCRIPTION (IMPORTANT) -->
  <div class="page-description">
    {{ page.content }}
  </div>

  <!-- Problem Section -->
  <h2>The Hidden Problem</h2>
  <p>{{ section.settings.problem_text }}</p>

  <!-- Research Highlight -->
  <div class="highlight-box">
    <strong>Research Insight:</strong>
    <p>{{ section.settings.research_text }}</p>
  </div>

  <!-- Solution -->
  <h2>The Breakthrough Solution</h2>
  <p>{{ section.settings.solution_text }}</p>

  <!-- Auto Product Pull (Optional) -->
  {% if section.settings.product != blank %}
    {% assign product = all_products[section.settings.product] %}
    <div class="product-box">
      <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}">
      <h3>{{ product.title }}</h3>
      <p>{{ product.price | money }}</p>
      <a href="{{ product.url }}" class="cta-button">
        👉 Try It Today
      </a>
    </div>
  {% endif %}

  <!-- Benefits -->
  <h2>Why People Love It</h2>
  <p>{{ section.settings.benefits_text }}</p>

  <!-- Testimonials -->
  <h2>Real Customer Results</h2>

  <div class="testimonial">
    ⭐⭐⭐⭐⭐ <br>
    "{{ section.settings.testimonial_1 }}" <br>
    – {{ section.settings.testimonial_name_1 }}
  </div>

  <div class="testimonial">
    ⭐⭐⭐⭐⭐ <br>
    "{{ section.settings.testimonial_2 }}" <br>
    – {{ section.settings.testimonial_name_2 }}
  </div>

  <!-- Final CTA -->
  <a href="{{ section.settings.final_cta_link }}" class="cta-button">
    🔥 {{ section.settings.final_cta_text }}
  </a>

</div>

{% schema %}
{
  "name": "Advertorial Template",
  "settings": [
    { "type": "text", "id": "author_name", "label": "Author Name", "default": "Health Editorial Team" },
    { "type": "text", "id": "headline", "label": "Headline" },
    { "type": "text", "id": "subheadline", "label": "Subheadline" },
    { "type": "richtext", "id": "intro_text", "label": "Intro Text" },
    { "type": "richtext", "id": "problem_text", "label": "Problem Text" },
    { "type": "richtext", "id": "research_text", "label": "Research Text" },
    { "type": "richtext", "id": "solution_text", "label": "Solution Text" },
    { "type": "richtext", "id": "benefits_text", "label": "Benefits Text" },
    { "type": "text", "id": "testimonial_1", "label": "Testimonial 1" },
    { "type": "text", "id": "testimonial_name_1", "label": "Testimonial 1 Name" },
    { "type": "text", "id": "testimonial_2", "label": "Testimonial 2" },
    { "type": "text", "id": "testimonial_name_2", "label": "Testimonial 2 Name" },
    { "type": "product", "id": "product", "label": "Select Product (Optional)" },
    { "type": "text", "id": "final_cta_text", "label": "Final CTA Text", "default": "Get Special Offer Now" },
    { "type": "url", "id": "final_cta_link", "label": "Final CTA Link" }
  ],
  "presets": [
    {
      "name": "Advertorial Page"
    }
  ]
}
{% endschema %}
