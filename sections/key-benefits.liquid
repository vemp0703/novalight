{% style %}

.key-benefits {
  padding: 60px 0;
}

.key-benefits__heading {
  text-align: center;
  font-size: 36px;
  font-weight: 600;
  margin-bottom: 12px;
}

.key-benefits__subheading {
  text-align: center;
  max-width: 700px;
  margin: 0 auto 40px;
  color: #666;
}

.key-benefits__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
}

.key-benefits__item {
  border: 1px solid var(--accent);
  border-radius: 14px;
  padding: 28px;
}

.key-benefits__icon {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background: var(--accent);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}

.key-benefits__title {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 8px;
}

.key-benefits__text {
  font-size: 14px;
  color: #555;
  line-height: 1.6;
}

@media (max-width: 990px) {
  .key-benefits__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 640px) {
  .key-benefits__grid {
    grid-template-columns: 1fr;
  }
}


{% endstyle %}


{% assign benefits = product.metafields.custom.product_benefits.value %}

{% if benefits != blank %}
<section class="key-benefits">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <h2 class="key-benefits__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="key-benefits__subheading">
        {{ section.settings.subheading }}
      </p>
    {% endif %}

    <div class="key-benefits__grid">
      {% for benefit in benefits %}
        {% assign item = benefit %}

        <div class="key-benefits__item" style="--accent: {{ item.color.value }}">
          
          {% if item.icon != blank %}
            <div class="key-benefits__icon">
              {{ item.icon.value }}
            </div>
          {% endif %}

          {% if item.title != blank %}
            <h3 class="key-benefits__title">
              {{ item.title.value }}
            </h3>
          {% endif %}

          {% if item.description != blank %}
            <p class="key-benefits__text">
              {{ item.description.value }}
            </p>
          {% endif %}

        </div>
      {% endfor %}
    </div>

  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Product Key Benefits",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Key Benefits"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Why customers love this product"
    }
  ],
  "presets": [
    {
      "name": "Product Key Benefits"
    }
  ]
}
{% endschema %}
