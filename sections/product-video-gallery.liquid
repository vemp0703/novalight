{% if product.metafields.custom.product_video_gallery != blank %}
<section class="theraface-videos">
  <div class="container">

    {% if section.settings.badge_text != blank %}
      <span class="badge">{{ section.settings.badge_text }}</span>
    {% endif %}

    <h2>{{ section.settings.heading }}</h2>

    {% if section.settings.subtitle != blank %}
      <p class="subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}

    <div class="video-row">

      {% assign video_html = product.metafields.custom.product_video_gallery | metafield_tag %}
      {% assign items = video_html | split: '<li>' %}

      {% for item in items %}
        {% if item contains '</li>' %}
          {% assign raw = item | split: '</li>' | first | strip | strip_html %}
          {% assign parts = raw | split: '|' %}

          {% assign video_url = parts[0] | strip %}
          {% assign title = parts[1] | default: 'Product Review' | strip %}
          {% assign views = parts[2] | default: '0' | strip %}

          <div class="video-card">
            <span class="views">👁 {{ views }}</span>

            <div class="video-thumb">

              {% if video_url contains 'youtube.com' or video_url contains 'youtu.be' %}
                <iframe
                  src="https://www.youtube.com/embed/{{ video_url | split: 'v=' | last }}?playsinline=1&rel=0"
                  allowfullscreen>
                </iframe>

              {% elsif video_url contains 'vimeo.com' %}
                <iframe
                  src="https://player.vimeo.com/video/{{ video_url | split: '/' | last }}"
                  allowfullscreen>
                </iframe>

              {% else %}
                <video muted playsinline preload="metadata">
                  <source src="{{ video_url }}" type="video/mp4">
                </video>
                <div class="play-btn">▶</div>
              {% endif %}

            </div>

            <div class="video-info">
              <strong>{{ title }}</strong>
            </div>
          </div>
        {% endif %}
      {% endfor %}

    </div>

    {% if section.settings.cta_text != blank %}
      <p class="cta-text">{{ section.settings.cta_text }}</p>
    {% endif %}

    {% if section.settings.cta_label != blank %}
      <a href="{{ section.settings.cta_link }}" class="cta-btn">
        {{ section.settings.cta_label }}
      </a>
    {% endif %}

  </div>
</section>

<style>
.theraface-videos {
  padding: 60px 20px;
  background: #fff;
  text-align: center;
}
.container {
  max-width: 1200px;
  margin: auto;
}
.badge {
  background: #eef2ff;
  color: #3b5cff;
  padding: 6px 14px;
  border-radius: 20px;
  font-size: 13px;
  display: inline-block;
  margin-bottom: 16px;
}
.subtitle {
  color: #666;
  margin-bottom: 40px;
}
.video-row {
  display: flex;
  gap: 20px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  padding-bottom: 10px;

  scrollbar-width: none;
  -ms-overflow-style: none;
}
.video-row::-webkit-scrollbar {
  display: none;
}
.video-card {
  min-width: 260px;
  scroll-snap-align: start;
  text-align: left;
  position: relative;
}
.views {
  position: absolute;
  top: 10px;
  left: 10px;
  background: rgba(0,0,0,0.75);
  color: #fff;
  font-size: 12px;
  padding: 4px 10px;
  border-radius: 14px;
  z-index: 2;
}
.video-thumb {
  position: relative;
  border-radius: 18px;
  overflow: hidden;
}
.video-thumb video,
.video-thumb iframe {
  width: 100%;
  height: 380px;
  object-fit: cover;
  border: none;
}
.play-btn {
  position: absolute;
  inset: 0;
  margin: auto;
  width: 54px;
  height: 54px;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  pointer-events: none;
}
.video-info {
  padding: 10px 6px;
}
.cta-text {
  margin-top: 40px;
  color: #666;
}
.cta-btn {
  display: inline-block;
  margin-top: 12px;
  padding: 14px 28px;
  background: #2b6cff;
  color: #fff;
  border-radius: 30px;
  text-decoration: none;
  font-weight: 600;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const videos = document.querySelectorAll('.video-thumb video');

  videos.forEach(video => {
    const playBtn = video.parentElement.querySelector('.play-btn');

    video.addEventListener('play', () => {
      if (playBtn) playBtn.style.display = 'none';
    });

    video.addEventListener('pause', () => {
      if (!video.ended && playBtn) playBtn.style.display = 'flex';
    });

    video.addEventListener('ended', () => {
      video.removeAttribute('controls');
      if (playBtn) playBtn.style.display = 'flex';
    });

    video.addEventListener('click', () => {
      videos.forEach(v => {
        if (v !== video) {
          v.pause();
          v.currentTime = 0;
          v.removeAttribute('controls');
          const btn = v.parentElement.querySelector('.play-btn');
          if (btn) btn.style.display = 'flex';
        }
      });

      if (video.paused) {
        video.setAttribute('controls', 'controls');
        video.play();
      }
    });
  });
});
</script>

{% endif %}

{% schema %}
{
  "name": "Product Video Gallery",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "▶ Real Results from Real People"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See TheraFace in Action"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Watch verified users and skincare experts share their transformation stories"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Ready to see results like these?"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button label",
      "default": "Get Your TheraFace Mask Today"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA button link"
    }
  ],
  "presets": [
    {
      "name": "Product Video Gallery"
    }
  ]
}
{% endschema %}
