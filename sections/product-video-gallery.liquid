<section class="theraface-videos">
  <div class="container">

    <h2>{{ section.settings.heading }}</h2>

    {% assign raw_html = product.metafields.custom.product_video_gallery.value | strip_html %}
    {% assign video_urls = raw_html | split: 'https://' %}

    {% if video_urls.size > 1 %}
      <div class="video-row">

        {% for item in video_urls %}
          {% if forloop.first == false %}
            {% assign video_url = 'https://' | append: item | split: ' ' | first | split: '\n' | first %}

            <div class="video-card">
              <div class="video-thumb">
                <video playsinline preload="metadata" muted>
                  <source src="{{ video_url }}" type="video/mp4">
                </video>
                <span class="play-btn">▶</span>
              </div>
            </div>

          {% endif %}
        {% endfor %}

      </div>
    {% else %}
      <p>No videos found.</p>
    {% endif %}

  </div>
</section>

<style>
.theraface-videos { padding: 60px 20px; text-align: center; }
.container { max-width: 1200px; margin: auto; }
.video-row {
  display: flex;
  gap: 20px;
  overflow-x: auto;
}
.video-card { min-width: 260px; }
.video-thumb {
  position: relative;
  border-radius: 16px;
  overflow: hidden;
  background: #000;
}
video { width: 100%; cursor: pointer; }
.play-btn {
  position: absolute;
  inset: 0;
  margin: auto;
  width: 50px;
  height: 50px;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
@media (min-width: 768px) {
  .video-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    overflow: visible;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('video').forEach(video => {
    video.addEventListener('click', () => {
      document.querySelectorAll('video').forEach(v => {
        if (v !== video) v.pause();
      });
      video.paused ? video.play() : video.pause();
    });
  });
});
</script>

{% schema %}
{
  "name": "Product Video Gallery",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product Videos"
    }
  ],
  "presets": [
    {
      "name": "Product Video Gallery"
    }
  ]
}
{% endschema %}
