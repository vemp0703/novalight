<section class="theraface-videos">
  {% if product.metafields.custom.product_video_gallery != blank %}
  <div class="container">

    {% if section.settings.badge_text != blank %}
      <span class="badge">{{ section.settings.badge_text }}</span>
    {% endif %}

    <h2>{{ section.settings.heading }}</h2>

    {% if section.settings.subtitle != blank %}
      <p class="subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}

    {% assign video_html = product.metafields.custom.product_video_gallery.value | metafield_tag %}

    {% assign video_items = video_html | split: '<li>' %}

    <div class="video-row">
      {% for item in video_items %}
        {% if item contains '</li>' %}
          {% assign video_url = item | split: '</li>' | first | strip %}
          {% if video_url != blank %}
            <div class="video-card">
              <div class="video-thumb">
                <video playsinline preload="metadata" muted>
                  <source src="{{ video_url }}" type="video/mp4">
                </video>
                <span class="play-btn">▶</span>
              </div>
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.cta_text != blank %}
      <p class="cta-text">{{ section.settings.cta_text }}</p>
    {% endif %}

    {% if section.settings.cta_label != blank %}
      <a href="{{ section.settings.cta_link }}" class="cta-btn">
        {{ section.settings.cta_label }}
      </a>
    {% endif %}

  </div>
  {% endif %}
</section>

<style>
.theraface-videos {
  padding: 60px 20px;
  background: #fff;
  text-align: center;
}
.container {
  max-width: 1200px;
  margin: auto;
}
.badge {
  display: inline-block;
  background: #f0f4ff;
  color: #3b5cff;
  padding: 6px 14px;
  border-radius: 20px;
  font-size: 13px;
  margin-bottom: 16px;
}
h2 {
  font-size: 32px;
  margin-bottom: 10px;
}
.subtitle {
  color: #666;
  margin-bottom: 40px;
}
.video-row {
  display: flex;
  gap: 20px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  padding-bottom: 10px;
}
.video-card {
  min-width: 260px;
  flex-shrink: 0;
  scroll-snap-align: start;
}
.video-thumb {
  position: relative;
  border-radius: 16px;
  overflow: hidden;
  background: #000;
}
.video-thumb video {
  width: 100%;
  height: auto;
  display: block;
  cursor: pointer;
}
.play-btn {
  position: absolute;
  inset: 0;
  margin: auto;
  width: 50px;
  height: 50px;
  background: rgba(255,255,255,0.9);
  border-radius: 50%;
  font-size: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.cta-text {
  margin-top: 40px;
  font-size: 14px;
  color: #666;
}
.cta-btn {
  display: inline-block;
  margin-top: 12px;
  padding: 14px 28px;
  background: #2b6cff;
  color: #fff;
  border-radius: 30px;
  text-decoration: none;
  font-weight: 600;
}
@media (min-width: 768px) {
  .video-row {
    overflow: visible;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const videos = document.querySelectorAll('.video-thumb video');

  videos.forEach(video => {
    video.addEventListener('click', function () {
      videos.forEach(v => {
        if (v !== this) {
          v.pause();
          v.removeAttribute('controls');
        }
      });

      if (this.paused) {
        this.play();
        this.muted = false;
        this.setAttribute('controls', 'controls');
      } else {
        this.pause();
      }
    });
  });
});
</script>

{% schema %}
{
  "name": "Product Video Gallery",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "▶ Real Results from Real People"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See TheraFace in Action"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Watch verified users and skincare experts share their transformation stories"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Ready to see results like these?"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button label",
      "default": "Get Your TheraFace Mask Today"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA button link"
    }
  ],
  "presets": [
    {
      "name": "Product Video Gallery"
    }
  ]
}
{% endschema %}
