{% comment %}
Dynamic Clinical Results Section (Matches Provided Design)
Controlled via product metafields + nested metaobjects
{% endcomment %}

{% assign show_section = product.metafields.custom.dynamic_results_section.value %}

{% if show_section and product.metafields.custom.dynamic_clinical_results_section != blank %}
  {% assign data = product.metafields.custom.dynamic_clinical_results_section.value %}

<section class="clinical-results">
  <div class="clinical-results__container">

    {% if data.badge_text != blank %}
      <span class="clinical-results__badge">{{ data.badge_text }}</span>
    {% endif %}

    {% if data.heading != blank %}
      <h2 class="clinical-results__heading">{{ data.heading }}</h2>
    {% endif %}

    {% if data.description != blank %}
      <p class="clinical-results__subtext">{{ data.description }}</p>
    {% endif %}

    {% if data.stats_blocks.value != blank %}
      <div class="clinical-results__stats">
        {% for stat in data.stats_blocks.value %}
          <div class="clinical-results__card">
            <span class="clinical-results__top-bar" style="background: {{ stat.color }}"></span>

            <div class="clinical-results__value" style="color: {{ stat.color }}">
              {{ stat.value }}
            </div>

            <div class="clinical-results__title">{{ stat.title }}</div>
            <div class="clinical-results__text">{{ stat.description }}</div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if data.disclaimer != blank %}
      <p class="clinical-results__disclaimer">{{ data.disclaimer }}</p>
    {% endif %}

  </div>
</section>
{% endif %}

<style>
.clinical-results {
  padding: 90px 20px;
  background: radial-gradient(120% 120% at 0% 0%, #1d3557 0%, #050913 60%);
  color: #ffffff;
}

.clinical-results__container {
  max-width: 1200px;
  margin: 0 auto;
  text-align: center;
}

.clinical-results__badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  font-size: 12px;
  border-radius: 999px;
  background: rgba(255,255,255,0.14);
  margin-bottom: 18px;
}

.clinical-results__heading {
  font-size: 44px;
  font-weight: 500;
  margin-bottom: 14px;
}

.clinical-results__subtext {
  max-width: 760px;
  margin: 0 auto 60px;
  font-size: 15px;
  opacity: 0.8;
}

.clinical-results__stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 26px;
  margin-bottom: 48px;
}

.clinical-results__card {
  position: relative;
  background: linear-gradient(180deg, rgba(255,255,255,0.1), rgba(255,255,255,0.02));
  border-radius: 18px;
  padding: 38px 26px 34px;
  backdrop-filter: blur(8px);
}

.clinical-results__top-bar {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 44px;
  height: 4px;
  border-radius: 4px;
}

.clinical-results__value {
  font-size: 38px;
  font-weight: 700;
  margin-bottom: 12px;
}

.clinical-results__title {
  font-size: 16px;
  font-weight: 500;
  margin-bottom: 6px;
}

.clinical-results__text {
  font-size: 13px;
  opacity: 0.75;
}

.clinical-results__disclaimer {
  max-width: 980px;
  margin: 0 auto;
  font-size: 11px;
  opacity: 0.6;
}

@media (max-width: 768px) {
  .clinical-results__heading { font-size: 30px; }
  .clinical-results { padding: 60px 16px; }
}
</style>

{% schema %}
{
  "name": "Dynamic Results Section",
  "settings": [],
  "presets": [
    { "name": "Dynamic Clinical Results" }
  ]
}
{% endschema %}