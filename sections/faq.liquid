{% if product.metafields.custom.frequent_ask_question != blank %}
  {% assign faq_content = product.metafields.custom.frequent_ask_question.value  | metafield_tag %}

  {{ faq_content }}
  <section class="faq-section my-12 max-w-4xl mx-auto px-4">
    <h2 class="text-2xl font-semibold text-center mb-4">Frequently Asked Questions</h2>
    <p class="text-center text-gray-600 mb-8">Everything you need to know about TheraFace Mask</p>

    <div class="faq-accordion border rounded-lg overflow-hidden">
      {% assign faqs = faq_content | split:'<h6>' %}
      {% for faq in faqs %}
        {% if faq != blank %}
          {% assign parts = faq | split:'</h6>' %}
          {% assign question = parts[0] | strip %}
          {% assign answer_html = parts[1] | strip %}
          <div class="faq-item border-b">
            <button class="faq-question w-full text-left px-4 py-3 flex justify-between items-center focus:outline-none">
              <span>{{ question }}</span>
              <span class="faq-icon text-blue-500 font-bold text-xl">+</span>
            </button>
            <div class="faq-answer px-4 py-3 hidden text-gray-700">
              {{ answer_html }}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </section>

  <style>
    .faq-question:hover { background-color: #f9f9f9; }
    .faq-icon.rotate { transform: rotate(45deg); transition: transform 0.3s ease; }
    .faq-answer { transition: max-height 0.3s ease; }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const faqButtons = document.querySelectorAll('.faq-question');

      faqButtons.forEach(btn => {
        btn.addEventListener('click', function() {
          const answer = this.nextElementSibling;
          const icon = this.querySelector('.faq-icon');

          if (answer.classList.contains('hidden')) {
            answer.classList.remove('hidden');
            icon.classList.add('rotate');
            icon.textContent = '−';
          } else {
            answer.classList.add('hidden');
            icon.classList.remove('rotate');
            icon.textContent = '+';
          }
        });
      });
    });
  </script>
{% endif %}
