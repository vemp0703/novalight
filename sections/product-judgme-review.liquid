{% comment %}
  Product Reviews – Judge.me Carousel (Recommended)
{% endcomment %}

{% if section.settings.show_section %}

<section class="product-reviews">
  <div class="page-width">

    <!-- Header -->
    <div class="reviews-header">
      <h3>{{ section.settings.heading }}</h3>

      <div class="reviews-summary">
        <div
          class="jdgm-widget jdgm-preview-badge"
          data-id="{{ product.id }}"
          data-template="badge"
        >
          {{ product.metafields.judgeme.badge }}
        </div>
      </div>

      <p class="verified-count">
        {{ section.settings.subtext }}
      </p>
    </div>

    <!-- Judge.me Carousel -->
    <div
      class="jdgm-widget jdgm-carousel"
      data-id="{{ product.id }}"
      data-auto-play="false"
      data-per-page="{{ section.settings.slides_desktop }}"
      data-per-page-mobile="{{ section.settings.slides_mobile }}"
    >
      {{ product.metafields.judgeme.carousel }}
    </div>

  </div>
</section>

{% endif %}

{% style %}
/* ===============================
   SECTION
================================ */

.product-reviews {
  padding: 70px 0;
  background: #fff;
}

.reviews-header {
  text-align: center;
  margin-bottom: 40px;
}

.reviews-header h3 {
  font-size: 32px;
  font-weight: 600;
}

.verified-count {
  font-size: 14px;
  color: #6b7280;
}

/* ===============================
   CAROUSEL CARD STYLE
================================ */

.jdgm-carousel-item {
  border: 1px solid #e5e7eb;
  border-radius: 18px;
  padding: 22px;
  background: #fff;
}

/* Stars */
.jdgm-star {
  color: #fbbf24 !important;
}

/* Title */
.jdgm-rev__title {
  font-weight: 600;
  margin: 10px 0 6px;
}

/* Body */
.jdgm-rev__body {
  font-size: 14px;
  color: #4b5563;
}

/* Author */
.jdgm-rev__author {
  font-size: 13px;
  color: #6b7280;
}

/* ===============================
   REMOVE UNWANTED UI
================================ */

.jdgm-write-rev-link,
.jdgm-row-actions,
.jdgm-rev__reply {
  display: none !important;
}

/* ===============================
   ARROWS
================================ */

.jdgm-carousel__left-arrow,
.jdgm-carousel__right-arrow {
  background: #000 !important;
  color: #fff !important;
  border-radius: 50%;
}

/* ===============================
   MOBILE
================================ */

@media (max-width: 768px) {
  .reviews-header h3 {
    font-size: 24px;
  }
}
{% endstyle %}

{% schema %}
{
  "name": "Product Reviews",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show reviews section",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 10,000+ Customers"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Sub text",
      "default": "Based on verified customer reviews"
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "label": "Slides per view (desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "slides_mobile",
      "label": "Slides per view",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    }
  ],
  "presets": [
    {
      "name": "Product Reviews",
      "category": "Product"
    }
  ]
}
{% endschema %}
