{% comment %}
  Product Reviews Section – Judge.me
  Fully compatible & production safe
{% endcomment %}

{% if section.settings.show_section %}

<section class="product-reviews">
  <div class="page-width">

    <!-- Header -->
    <div class="reviews-header">
      <h3>{{ section.settings.heading }}</h3>

      <!-- Judge.me Preview Badge -->
      <div class="reviews-summary">
        <div
          class="jdgm-widget jdgm-preview-badge"
          data-id="{{ product.id }}"
          data-template="badge"
        >
          {{ product.metafields.judgeme.badge }}
        </div>
      </div>

    </div>

    <!-- Full Reviews Widget -->
    <div
      id="judgeme_product_reviews"
      class="jdgm-widget jdgm-review-widget"
      data-id="{{ product.id }}"
      data-product-title="{{ product.title | escape }}"
    >
      {{ product.metafields.judgeme.widget }}
    </div>

  </div>
</section>

{% endif %}

{% style %}
/* =========================
   Product Reviews Styling
   ========================= */

.product-reviews {
  padding: 60px 0;
  background: #fff;
}

.reviews-header {
  text-align: center;
  margin-bottom: 40px;
}

.reviews-header h3 {
  font-size: 28px;
  font-weight: 600;
  margin-bottom: 10px;
}

/* Center badge */
.reviews-summary .jdgm-preview-badge {
  display: inline-block;
}

/* Stars color */
.jdgm-star,
.jdgm-star.jdgm--on {
  color: #FFC107 !important;
}

/* Rating text */
.jdgm-prev-badge__text {
  font-size: 14px;
  color: #777;
}

/* Review cards */
.jdgm-rev {
  border: 1px solid #eee;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 20px;
  background: #fff;
}

/* Review title */
.jdgm-rev__title {
  font-weight: 600;
  margin-bottom: 6px;
}

/* Review body */
.jdgm-rev__body {
  font-size: 14px;
  color: #555;
}

/* Author */
.jdgm-rev__author {
  font-size: 13px;
  color: #999;
}

/* Histogram */
.jdgm-histogram__bar {
  background: #eee !important;
  border-radius: 6px;
}

.jdgm-histogram__bar-content {
  background: #FFC107 !important;
  border-radius: 6px;
}

/* Write review button */
.jdgm-write-rev-link {
  background: #000;
  color: #fff !important;
  padding: 12px 24px;
  border-radius: 30px;
  display: inline-block;
  font-size: 14px;
}

/* Mobile */
@media (max-width: 768px) {
  .reviews-header h3 {
    font-size: 22px;
  }
}
{% endstyle %}

{% schema %}
{
  "name": "Product Reviews",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show reviews section",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Loved by our customers"
    }
  ],
  "presets": [
    {
      "name": "Product Reviews",
      "category": "Product"
    }
  ]
}
{% endschema %}
