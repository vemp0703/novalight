{% schema %}
{
  "name": "Product Reviews",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show Reviews Section",
      "default": true
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Loved by Customers"
    }
  ],
  "presets": [
    {
      "name": "Product Reviews",
      "category": "Product",
      "blocks": []
    }
  ]
}
{% endschema %}

{% if section.settings.show_section %}
<section class="product-reviews">
  <div class="page-width">

    <!-- Top Rating -->
    <div class="reviews-header">
      <h3>{{ section.settings.section_heading }} {{ product.metafields.judgeme.total_reviews.value | default: 0 }} Customers</h3>
      <div class="reviews-summary">
        <div class="stars">
          {% assign avg_rating = product.metafields.judgeme.average_rating.value | default: 0 %}
          {% for i in (1..5) %}
            {% if i <= avg_rating %}
              <span class="star filled">★</span>
            {% else %}
              <span class="star">★</span>
            {% endif %}
          {% endfor %}
        </div>
        <div class="rating-number">{{ avg_rating | round: 1 }}</div>
      </div>
      <p class="verified-count">Based on {{ product.metafields.judgeme.total_reviews.value | default: 0 }} verified reviews</p>
    </div>

    <!-- Rating Breakdown -->
    <div class="rating-breakdown">
      <h4>Rating Breakdown</h4>
      {% assign rating_counts = product.metafields.judgeme.rating_counts %}
      {% for star in (5..1) %}
        <div class="rating-bar-row">
          <div class="star-label">{{ star }} ★</div>
          <div class="bar-wrapper">
            {% assign count = rating_counts[star] | default: 0 %}
            {% assign max_count = rating_counts[5] | default: 1 %}
            {% assign width = count | times: 100 | divided_by: max_count %}
            <div class="bar" style="width: {{ width }}%;"></div>
          </div>
          <div class="count">{{ count }}</div>
        </div>
      {% endfor %}
    </div>

    <!-- Reviews List -->
    <div class="reviews-list">
      {% for review in product.metafields.judgeme.reviews %}
        <div class="review-card">
          <div class="review-stars">
            {% for i in (1..5) %}
              {% if i <= review.rating %}
                <span class="star filled">★</span>
              {% else %}
                <span class="star">★</span>
              {% endif %}
            {% endfor %}
          </div>
          <h5 class="review-title">{{ review.title }}</h5>
          <p class="review-content">{{ review.content }}</p>
          <div class="review-meta">
            <span class="review-author">{{ review.author_name }}</span>
            <span class="review-date">{{ review.date | date: "%B %d, %Y" }}</span>
          </div>
          {% if review.helpful_count %}
            <div class="review-helpful">Helpful ({{ review.helpful_count }})</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

  </div>
</section>
{% endif %}
