{% comment %}
  Section: Product Reviews
  Requires Judge.me app
{% endcomment %}

<section class="product-reviews">
  <div class="page-width">

    <!-- Top Rating -->
    <div class="reviews-header">
      <h3>Loved by {{ product.metafields.judgeme.total_reviews.value | default: 0 }} Customers</h3>
      <div class="reviews-summary">
        <div class="stars">
          {% assign avg_rating = product.metafields.judgeme.average_rating.value | default: 0 %}
          {% for i in (1..5) %}
            {% if i <= avg_rating %}
              <span class="star filled">★</span>
            {% else %}
              <span class="star">★</span>
            {% endif %}
          {% endfor %}
        </div>
        <div class="rating-number">{{ avg_rating | round: 1 }}</div>
      </div>
      <p class="verified-count">Based on {{ product.metafields.judgeme.total_reviews.value | default: 0 }} verified reviews</p>
    </div>

    <!-- Rating Breakdown -->
    <div class="rating-breakdown">
      <h4>Rating Breakdown</h4>
      {% assign rating_counts = product.metafields.judgeme.rating_counts %}
      {% for star in (5..1) %}
        <div class="rating-bar-row">
          <div class="star-label">{{ star }} ★</div>
          <div class="bar-wrapper">
            {% assign count = rating_counts[star] | default: 0 %}
            {% assign max_count = rating_counts[5] | default: 1 %}
            {% assign width = count | times: 100 | divided_by: max_count %}
            <div class="bar" style="width: {{ width }}%;"></div>
          </div>
          <div class="count">{{ count }}</div>
        </div>
      {% endfor %}
    </div>

    <!-- Reviews List -->
    <div class="reviews-list">
      {% for review in product.metafields.judgeme.reviews %}
        <div class="review-card">
          <div class="review-stars">
            {% for i in (1..5) %}
              {% if i <= review.rating %}
                <span class="star filled">★</span>
              {% else %}
                <span class="star">★</span>
              {% endif %}
            {% endfor %}
          </div>
          <h5 class="review-title">{{ review.title }}</h5>
          <p class="review-content">{{ review.content }}</p>
          <div class="review-meta">
            <span class="review-author">{{ review.author_name }}</span>
            <span class="review-date">{{ review.date | date: "%B %d, %Y" }}</span>
          </div>
          {% if review.helpful_count %}
            <div class="review-helpful">Helpful ({{ review.helpful_count }})</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% style %}
.product-reviews {
  padding: 60px 0;
  font-family: sans-serif;
}
.reviews-header {
  text-align: center;
  margin-bottom: 40px;
}
.reviews-header h3 {
  font-size: 28px;
  font-weight: 600;
  margin-bottom: 10px;
}
.reviews-summary {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10px;
  margin-bottom: 5px;
}
.stars .star {
  color: #ccc;
  font-size: 20px;
}
.stars .star.filled {
  color: #FFC107;
}
.rating-number {
  font-weight: 600;
  font-size: 20px;
}
.verified-count {
  font-size: 14px;
  color: #777;
}
.rating-breakdown {
  max-width: 400px;
  margin: 0 auto 50px;
}
.rating-breakdown h4 {
  text-align: center;
  margin-bottom: 20px;
  font-size: 18px;
}
.rating-bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 8px;
  gap: 10px;
}
.star-label {
  width: 30px;
  font-size: 14px;
}
.bar-wrapper {
  flex: 1;
  background: #eee;
  height: 10px;
  border-radius: 5px;
  overflow: hidden;
}
.bar {
  height: 100%;
  background: #FFC107;
  border-radius: 5px;
}
.count {
  width: 25px;
  text-align: right;
  font-size: 14px;
}
.reviews-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 20px;
}
.review-card {
  border: 1px solid #eee;
  border-radius: 12px;
  padding: 20px;
  background: #fff;
}
.review-stars .star {
  font-size: 16px;
  color: #ccc;
}
.review-stars .star.filled {
  color: #FFC107;
}
.review-title {
  font-weight: 600;
  margin: 10px 0 5px;
}
.review-content {
  font-size: 14px;
  color: #555;
  margin-bottom: 10px;
}
.review-meta {
  font-size: 12px;
  color: #999;
  display: flex;
  gap: 10px;
}
.review-helpful {
  font-size: 12px;
  color: #555;
  margin-top: 5px;
}
{% endstyle %}
{% schema %}
{
  "name": "Product Reviews",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show Reviews Section",
      "default": true
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Loved by Customers"
    }
  ],
  "presets": [
    {
      "name": "Product Reviews",
      "category": "Product",
      "blocks": []
    }
  ]
}
{% endschema %}