{%- style -%}
  .testimonial-slider-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
  }
  
  .testimonial-slider {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  
  .section-header {
    text-align: center;
    margin-bottom: 60px;
  }
  
  .section-header h2 {
    font-size: 42px;
    color: #333;
    margin-bottom: 15px;
    font-weight: 700;
  }
  
  .testimonial-slider-wrapper {
    position: relative;
    overflow: hidden;
  }
  
  .testimonial-track {
    display: flex;
    gap: 30px;
    transition: transform 0.5s ease;
    padding: 10px 0 30px;
  }
  
  .testimonial-card {
    flex: 0 0 calc((100% - 60px) / 3);
    background: white;
    border-radius: 12px;
    padding: 35px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }
  
  .testimonial-content {
    margin-bottom: 25px;
  }
  
  .testimonial-content p {
    font-size: 18px;
    line-height: 1.6;
    color: #555;
    font-style: italic;
    margin: 0;
  }
  
  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 20px;
  }
  
  .author-avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    font-weight: bold;
    color: #666;
    overflow: hidden;
  }
  
  .author-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .author-info h4 {
    margin: 0 0 5px 0;
    font-size: 18px;
    color: #333;
  }
  
  .author-info p {
    margin: 0;
    color: #777;
    font-size: 14px;
  }
  
  .testimonial-rating {
    margin-bottom: 20px;
  }
  
  .stars {
    display: flex;
    gap: 4px;
  }
  
  .stars img {
    width: 20px;
    height: 20px;
  }
  
  .testimonial-date {
    color: #999;
    font-size: 14px;
    margin-top: 5px;
  }
  
  .slider-controls {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 40px;
  }
  
  .slider-btn {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: white;
    border: 1px solid #e0e0e0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }
  
  .slider-btn:hover {
    background: #f5f5f5;
    transform: translateY(-2px);
  }
  
  .slider-btn svg {
    width: 24px;
    height: 24px;
  }
  
  .slider-dots {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 30px;
  }
  
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ddd;
    cursor: pointer;
    transition: background 0.3s ease;
  }
  
  .dot.active {
    background: #333;
  }
  
  /* Tablet: Show 2 cards */
  @media (max-width: 1024px) {
    .testimonial-card {
      flex: 0 0 calc((100% - 30px) / 2);
    }
  }
  
  /* Mobile: Show 1 card */
  @media (max-width: 768px) {
    .testimonial-slider-section {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    
    .testimonial-slider {
      padding: 0 15px;
    }
    
    .section-header h2 {
      font-size: 32px;
    }
    
    .testimonial-card {
      flex: 0 0 100%;
      padding: 25px;
    }
    
    .testimonial-track {
      gap: 20px;
    }
  }
  
  @media (max-width: 480px) {
    .testimonial-card {
      padding: 20px;
    }
    
    .section-header h2 {
      font-size: 28px;
    }
    
    .slider-btn {
      width: 40px;
      height: 40px;
    }
    
    .author-avatar {
      width: 50px;
      height: 50px;
    }
    
    .testimonial-content p {
      font-size: 16px;
    }
  }

  .testimonial-date {
    margin: 0;
}

.testimonial-author {
    justify-content: space-between;
}

.testimonial-content p {
    font-style: normal;
}

.slider-dots {
    display: none;
}

.slider-controls {
    margin-top: 20px;
}
@media (max-width:767px){
    .slider-controls {
    margin-top: 0;
}

}
{%- endstyle -%}

<section class="testimonial-slider-section" data-section-id="{{ section.id }}">
  <div class="testimonial-slider">
    <div class="section-header">
      <h2>{{ section.settings.section_title }}</h2>
    </div>
    
    <div class="testimonial-slider-wrapper">
      <div class="testimonial-track" id="testimonial-track-{{ section.id }}">
        {% for block in section.blocks %}
          <div class="testimonial-card" {{ block.shopify_attributes }}>
                 <div class="testimonial-rating">
              <div class="stars">
                {% assign rating = block.settings.rating %}
                {% for i in (1..5) %}
                  {% if i <= rating %}
                    <img src="{{ section.settings.star_image | img_url: '20x20' }}" 
                         alt="Star" 
                         width="20" 
                         height="20"
                         loading="lazy">
                  {% else %}
                    <img src="{{ section.settings.star_empty_image | default: section.settings.star_image | img_url: '20x20' }}" 
                         alt="Empty Star" 
                         width="20" 
                         height="20"
                         loading="lazy">
                  {% endif %}
                {% endfor %}
              </div>
              
            </div>
            <div class="testimonial-content">
              <p>{{ block.settings.testimonial_text }}</p>
            </div>
            
            <div class="testimonial-author">
              
              
              <div class="author-info">
                <h4>{{ block.settings.author_name }}</h4>
                <p>{{ block.settings.author_position }}</p>
               
              </div>
               <div class="testimonial-date">{{ block.settings.date }}</div>
            </div>
            
       
          </div>
        {% endfor %}
      </div>
    </div>
    
    {% if section.blocks.size > 1 %}
      <div class="slider-controls">
        <button class="slider-btn prev-btn" id="prev-btn-{{ section.id }}" aria-label="Previous testimonial">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 18l-6-6 6-6"/>
          </svg>
        </button>
        <button class="slider-btn next-btn" id="next-btn-{{ section.id }}" aria-label="Next testimonial">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </button>
      </div>
      
      <div class="slider-dots" id="slider-dots-{{ section.id }}">
        {% for i in (1..section.blocks.size) %}
          {% assign total_slides = section.blocks.size %}
          {% assign items_per_view = 3 %}
          {% assign total_dots = total_slides | divided_by: items_per_view | ceil %}
          {% if forloop.index <= total_dots %}
            <div class="dot {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}"></div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const sectionId = '{{ section.id }}';
  const track = document.getElementById(`testimonial-track-${sectionId}`);
  const cards = track?.querySelectorAll('.testimonial-card');
  const prevBtn = document.getElementById(`prev-btn-${sectionId}`);
  const nextBtn = document.getElementById(`next-btn-${sectionId}`);
  const dotsContainer = document.getElementById(`slider-dots-${sectionId}`);
  const dots = dotsContainer?.querySelectorAll('.dot');
  
  if (!track || !cards || cards.length <= 1) return;
  
  let currentSlide = 0;
  let itemsPerView = 3;
  let totalSlides = Math.ceil(cards.length / itemsPerView);
  
  function updateItemsPerView() {
    const screenWidth = window.innerWidth;
    if (screenWidth <= 768) {
      itemsPerView = 1;
    } else if (screenWidth <= 1024) {
      itemsPerView = 2;
    } else {
      itemsPerView = 3;
    }
    totalSlides = Math.ceil(cards.length / itemsPerView);
    updateDots();
    updateSlider();
  }
  
  function updateSlider() {
    const cardWidth = cards[0].offsetWidth + 30; // width + gap
    const translateX = -(currentSlide * cardWidth * itemsPerView);
    track.style.transform = `translateX(${translateX}px)`;
    
    updateDots();
  }
  
  function updateDots() {
    if (dots) {
      dots.forEach((dot, index) => {
        dot.classList.toggle('active', index === currentSlide);
      });
      
      // Hide/show dots based on total slides
      const totalDots = Math.ceil(cards.length / itemsPerView);
      dots.forEach((dot, index) => {
        dot.style.display = index < totalDots ? 'block' : 'none';
      });
    }
  }
  
  if (prevBtn) {
    prevBtn.addEventListener('click', () => {
      currentSlide = currentSlide > 0 ? currentSlide - 1 : totalSlides - 1;
      updateSlider();
    });
  }
  
  if (nextBtn) {
    nextBtn.addEventListener('click', () => {
      currentSlide = currentSlide < totalSlides - 1 ? currentSlide + 1 : 0;
      updateSlider();
    });
  }
  
  if (dots) {
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        currentSlide = index;
        updateSlider();
      });
    });
  }
  
  // Initialize items per view
  updateItemsPerView();
  
  // Update on resize
  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      const previousItemsPerView = itemsPerView;
      updateItemsPerView();
      
      // Adjust current slide if needed
      if (itemsPerView !== previousItemsPerView) {
        currentSlide = Math.min(currentSlide, totalSlides - 1);
        updateSlider();
      }
    }, 250);
  });
  
  // Auto slide (optional)
  {% if section.settings.autoplay %}
    setInterval(() => {
      currentSlide = currentSlide < totalSlides - 1 ? currentSlide + 1 : 0;
      updateSlider();
    }, {{ section.settings.autoplay_speed | default: 5000 }});
  {% endif %}
});
</script>

{% schema %}
{
