{% style %}
.product-details {
  padding: 5rem;
}

.product-details__title {
    color: #0F172B;
    text-align: center;
    font-family: Marcellus;
    font-size: 44px;
    font-style: normal;
    font-weight: 400;
    line-height: 52.8px; /* 120% */
    letter-spacing: -0.88px;
}

.product-details__subtitle {
    color: #45556C;
    text-align: center;
    font-family: Jost;
    font-size: 17px;
    font-style: normal;
    font-weight: 400;
    line-height: 28.9px;
    letter-spacing: normal;
    white-space: normal;
    word-spacing: normal;
}

/* Tabs */
.product-tabs {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin: 40px 0 48px;
  flex-wrap: wrap;
}

.product-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 24px;
    border-radius: 999px;
    background: #f1f5f9;
    border: none;
    font-size: 16px;
    cursor: pointer;
    transition: all .25s ease;
    font-family: 'Lato';
   color:#0F172A
}

.product-tab.active {
  background: linear-gradient(135deg, #0ea5e9, #2563eb);
  color: #fff;
  box-shadow: 0 8px 20px rgba(37,99,235,.25);
}

/* Panel */
.product-tab-panel {
  display: none;
}

.product-tab-panel.active {
  display: block;
  
}

.product-tab-panel.active img{
    filter: brightness(0) invert(1);
}
/* Header */
.product-panel-header {
  display: flex;
  gap: 14px;
  margin-bottom: 24px;
}

.product-panel-icon {
  width: 64px;
  height: 64px;
  border-radius: 12px;
  background: linear-gradient(135deg, #0ea5e9, #2563eb);
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-panel-icon img {
  width: 32px;
  height: 32px;
}

.product-panel-header h3 {
    color: #0F172B;
    font-family: "Marcellus";
    font-size: 28px;
    font-style: normal;
    font-weight: 400;
    line-height: 36.4px; /* 130% */
    letter-spacing: -0.28px;
    margin:auto;
}

.product-panel-header p {
    color: #45556C;
    font-family: "Jost";
    font-size: 17px;
    font-style: normal;
    font-weight: 400;
    line-height: 28.9px;
    margin:auto;
}

/* Card */
.product-details-card {
  border: 1px solid #e5e7eb;
  border-radius: 16px;
  padding: 32px;
}
/* Inactive tab icon – matches #45556C */
.product-tab img {
  filter: brightness(0) saturate(100%)
          invert(32%) sepia(14%) saturate(820%)
          hue-rotate(176deg) brightness(90%) contrast(92%);
  transition: filter 0.25s ease;
}

/* Active tab icon – white */
.product-tab.active img {
  filter: brightness(0) invert(1);
}
@media (max-width: 768px) {
  .product-details-card {
    padding: 20px;
  }
}
{% endstyle %}

<div class="product-details page-width">
  <h2 class="product-details__title">{{ section.settings.heading }}</h2>
  <p class="product-details__subtitle">{{ section.settings.subheading }} {{ product.title }}</p>

  <!-- Tabs -->
  <div class="product-tabs">
    {% for block in section.blocks %}
      <button
        class="product-tab{% if forloop.first %} active{% endif %}"
        data-tab="tab-{{ block.id }}"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.icon != blank %}
          <img
            src="{{ block.settings.icon | image_url: width: 32 }}"
            alt=""
            width="21"
            height="21"
          >
        {% endif %}
        {{ block.settings.label }}
      </button>
    {% endfor %}
  </div>

  <!-- Panels -->
  {% for block in section.blocks %}
    <div
      class="product-tab-panel{% if forloop.first %} active{% endif %}"
      id="tab-{{ block.id }}"
    >
      <div class="product-panel-header">
        <div class="product-panel-icon">
          {% if block.settings.icon != blank %}
            <img
              src="{{ block.settings.icon | image_url: width: 48 }}"
              alt=""
              width="48"
              height="48"
            >
          {% endif %}
        </div>
        <div>
          <h3>{{ block.settings.label }}</h3>
          <p>{{ block.settings.description }}</p>
        </div>
      </div>

      <div class="product-details-card">
        {{ tabs[block.settings.metafield_key] }}
        {% if block.settings.metafield_key == 'description' %}
            {{ product.description }}
            {% elsif product.metafields.tabs[block.settings.metafield_key] != blank %}
            {{ product.metafields.tabs[block.settings.metafield_key] | metafield_tag }}
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>

<script>
document.querySelectorAll('.product-tab').forEach(tab => {
  tab.addEventListener('click', () => {
    document.querySelectorAll('.product-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.product-tab-panel').forEach(p => p.classList.remove('active'));

    tab.classList.add('active');
    document.getElementById(tab.dataset.tab).classList.add('active');
  });
});
</script>

{% schema %}
{
  "name": "Product Details Tabs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Product Details",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "default": "Everything you need to know about the product",
      "label": "Subheading"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Tab icon"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "default": "Care & Maintenance"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Tab description",
          "default": "Detailed information and specifications"
        },
        {
          "type": "text",
          "id": "metafield_key",
          "label": "Metafield key",
          "info": "Example: care, specifications, technology"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Details Tabs",
      "blocks": [
        { "type": "tab" },
        { "type": "tab" },
        { "type": "tab" },
        { "type": "tab" }
      ]
    }
  ]
}
{% endschema %}
