{% assign video_gen_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .video-video-gallery-{{ video_gen_id }} {
    display: block;
    width: {{ section.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ section.settings.section_padding }}px 0;
  }

  .video-video-gallery__contvideoner-{{ video_gen_id }} {
    position: relative;
    width: 100%;
  }

  .video-video-gallery__heading-{{ video_gen_id }} {
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: {{ section.settings.heading_spacing }}px;
    font-size: {{ section.settings.heading_size }}px;
    color: {{ section.settings.heading_color }};
  }
  .video-video-gallery__description-{{ video_gen_id }} {
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: {{ section.settings.heading_spacing }}px;
    font-size: 18px;
    color: {{ section.settings.heading_color }};
  }

  .video-video-gallery__carousel-{{ video_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.video_border_radius }}px;
  }

  .video-video-gallery__track-{{ video_gen_id }} {
    display: flex;
    gap: {{ section.settings.video_gap }}px;
    transition: transform 0.4s ease;
  }

  .video-video-gallery__slide-{{ video_gen_id }} {
    flex: 0 0 calc((100% - ({{ section.settings.videos_per_row_desktop | minus: 1 }} * {{ section.settings.video_gap }}px)) / {{ section.settings.videos_per_row_desktop }});
    position: relative;
    background-color: {{ section.settings.video_background }};
    border-radius: {{ section.settings.video_border_radius }}px;
    overflow: hidden;
  }

  .video-video-gallery__video-wrapper-{{ video_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    background-color: #000;
    border-radius: {{ section.settings.video_border_radius }}px;
    overflow: hidden;
    min-height:450px;
  }

  .video-video-gallery__video-{{ video_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-video-gallery__controls-{{ video_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: {{ section.settings.controls_spacing }}px;
  }

  .video-video-gallery__button-{{ video_gen_id }} {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .video-video-gallery__button-{{ video_gen_id }}:hover:not(:disabled) {
    background-color: {{ section.settings.button_hover_background }};
    transform: scale(1.1);
  }

  .video-video-gallery__button-{{ video_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .video-video-gallery__button-{{ video_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .video-video-gallery__dots-{{ video_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .video-video-gallery__dot-{{ video_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ section.settings.dot_color }};
    opacity: 0.3;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }

  .video-video-gallery__dot-{{ video_gen_id }}.active {
    opacity: 1;
    background-color: {{ section.settings.dot_active_color }};
  }

  .video-video-gallery__empty-state-{{ video_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    background-color: #f4f4f4;
    border-radius: {{ section.settings.video_border_radius }}px;
  }

  .video-video-gallery__empty-icon-{{ video_gen_id }} {
    width: 80px;
    height: 80px;
    margin: 0 auto 20px;
    opacity: 0.3;
  }

  .video-video-gallery__empty-text-{{ video_gen_id }} {
    font-size: 16px;
    color: #666;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .video-video-gallery__slide-{{ video_gen_id }} {
      flex: 0 0 calc((100% - ({{ section.settings.videos_per_row_tablet | minus: 1 }} * {{ section.settings.video_gap }}px)) / {{ section.settings.videos_per_row_tablet }});
    }
  }

  @media screen and (max-width: 749px) {
    .video-video-gallery-{{ video_gen_id }} {
      width: 100%;
    }

    .video-video-gallery__slide-{{ video_gen_id }} {
      flex: 0 0 calc((100% - ({{ section.settings.videos_per_row_mobile | minus: 1 }} * {{ section.settings.video_gap }}px)) / {{ section.settings.videos_per_row_mobile }});
    }

    .video-video-gallery__heading-{{ video_gen_id }} {
      font-size: calc({{ section.settings.heading_size }}px * 0.8);
    }
  }
{% endstyle %}

<div class="video-gallery-{{ video_gen_id }}" data-gallery>
  {% assign gallery = product.metafields.custom.product_video_gallery.value %}
  {% assign video_list = '' | split: ',' %}

  {% if gallery != blank and gallery.children != blank %}
    {% for child in gallery.children %}
      {% assign video_list = video_list | concat: child.value | split: ';' %}
    {% endfor %}
  {% endif %}

  <div class="video-gallery__track-{{ video_gen_id }}" data-track>
    {% for video in video_list %}
      {% assign video_url = video | strip %}
      {% if video_url != blank %}
        <div class="video-gallery__slide-{{ video_gen_id }}">
          <video
            class="video-gallery__video-{{ video_gen_id }}"
            {% if section.settings.autoplay %} autoplay {% endif %}
            {% if section.settings.loop %} loop {% endif %}
            {% if section.settings.muted %} muted {% endif %}
            {% if section.settings.show_controls %} controls {% endif %}
            playsinline
            preload="metadata"
          >
            <source src="{{ video_url }}" type="video/mp4">
          </video>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {% if section.settings.show_navigation %}
    <button data-prev class="video-gallery__button-{{ video_gen_id }}">Prev</button>
    <button data-next class="video-gallery__button-{{ video_gen_id }}">Next</button>
  {% endif %}

  <div data-dots class="video-gallery__dots-{{ video_gen_id }}"></div>
</div>

<script>
  (function() {
    const gallery = document.querySelector('[data-gallery]');
    if (!gallery) return;

    const track = gallery.querySelector('[data-track]');
    const slides = Array.from(track.children);
    const prevButton = gallery.querySelector('[data-prev]');
    const nextButton = gallery.querySelector('[data-next]');
    const dotsContainer = gallery.querySelector('[data-dots]');

    let currentIndex = 0;
    let videosPerView = {{ section.settings.videos_per_row_desktop }};
    const gap = parseInt(getComputedStyle(track).gap) || {{ section.settings.video_gap }};

    function updateVideosPerView() {
      const width = window.innerWidth;
      if (width <= 749) videosPerView = {{ section.settings.videos_per_row_mobile }};
      else if (width <= 989) videosPerView = {{ section.settings.videos_per_row_tablet }};
      else videosPerView = {{ section.settings.videos_per_row_desktop }};
    }

    function updateCarousel() {
      const slideWidth = slides[0].offsetWidth;
      const offset = -(currentIndex * (slideWidth + gap));
      track.style.transform = `translateX(${offset}px)`;

      if (prevButton) prevButton.disabled = currentIndex === 0;
      if (nextButton) nextButton.disabled = currentIndex >= slides.length - videosPerView;

      if (dotsContainer) {
        dotsContainer.innerHTML = '';
        for (let i = 0; i <= slides.length - videosPerView; i++) {
          const dot = document.createElement('button');
          dot.className = i === currentIndex ? 'active' : '';
          dot.addEventListener('click', () => { currentIndex = i; updateCarousel(); });
          dotsContainer.appendChild(dot);
        }
      }
    }

    if (prevButton) prevButton.addEventListener('click', () => { currentIndex--; updateCarousel(); });
    if (nextButton) nextButton.addEventListener('click', () => { currentIndex++; updateCarousel(); });
    window.addEventListener('resize', () => { updateVideosPerView(); updateCarousel(); });

    updateVideosPerView();
    updateCarousel();
  })();
</script>

{% schema %}
{
  "name": "PDP product video gallery",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product videos"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Product videos"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 28
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Heading spacing",
      "default": 24
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section padding",
      "default": 40
    },
    {
      "type": "select",
      "id": "videos_per_row_desktop",
      "label": "Videos per row (desktop)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "videos_per_row_tablet",
      "label": "Videos per row (tablet)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "videos_per_row_mobile",
      "label": "Videos per row (mobile)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "video_gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Gap between videos",
      "default": 16
    },
    {
      "type": "header",
      "content": "Video settings"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay videos",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop videos",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "Mute videos",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show video controls",
      "default": true
    },
    {
      "type": "color",
      "id": "video_background",
      "label": "Video background",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "video_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Video border radius",
      "default": 10
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show navigation",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    },
    {
      "type": "range",
      "id": "controls_spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Controls spacing",
      "default": 24
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button hover background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button icon color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "dot_active_color",
      "label": "Active dot color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Autoplay carousel"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable carousel autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay interval",
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "PDP Product video gallery"
    }
  ]
}
{% endschema %}
