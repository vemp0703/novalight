{% assign video_gen_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .video-video-gallery-{{ video_gen_id }} {
    display: block;
    width: {{ section.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ section.settings.section_padding }}px 0;
  }

  .video-video-gallery__contvideoner-{{ video_gen_id }} {
    position: relative;
    width: 100%;
  }

  .video-video-gallery__heading-{{ video_gen_id }} {
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: {{ section.settings.heading_spacing }}px;
    font-size: {{ section.settings.heading_size }}px;
    color: {{ section.settings.heading_color }};
  }
  .video-video-gallery__description-{{ video_gen_id }} {
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: {{ section.settings.heading_spacing }}px;
    font-size: 18px;
    color: {{ section.settings.heading_color }};
  }

  .video-video-gallery__carousel-{{ video_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.video_border_radius }}px;
  }

  .video-video-gallery__track-{{ video_gen_id }} {
    display: flex;
    gap: {{ section.settings.video_gap }}px;
    transition: transform 0.4s ease;
  }

  .video-video-gallery__slide-{{ video_gen_id }} {
    flex: 0 0 calc((100% - ({{ section.settings.videos_per_row_desktop | minus: 1 }} * {{ section.settings.video_gap }}px)) / {{ section.settings.videos_per_row_desktop }});
    position: relative;
    background-color: {{ section.settings.video_background }};
    border-radius: {{ section.settings.video_border_radius }}px;
    overflow: hidden;
  }

  .video-video-gallery__video-wrapper-{{ video_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    background-color: #000;
    border-radius: {{ section.settings.video_border_radius }}px;
    overflow: hidden;
    min-height:450px;
  }

  .video-video-gallery__video-{{ video_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-video-gallery__controls-{{ video_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: {{ section.settings.controls_spacing }}px;
  }

  .video-video-gallery__button-{{ video_gen_id }} {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .video-video-gallery__button-{{ video_gen_id }}:hover:not(:disabled) {
    background-color: {{ section.settings.button_hover_background }};
    transform: scale(1.1);
  }

  .video-video-gallery__button-{{ video_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .video-video-gallery__button-{{ video_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .video-video-gallery__dots-{{ video_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .video-video-gallery__dot-{{ video_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ section.settings.dot_color }};
    opacity: 0.3;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }

  .video-video-gallery__dot-{{ video_gen_id }}.active {
    opacity: 1;
    background-color: {{ section.settings.dot_active_color }};
  }

  .video-video-gallery__empty-state-{{ video_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    background-color: #f4f4f4;
    border-radius: {{ section.settings.video_border_radius }}px;
  }

  .video-video-gallery__empty-icon-{{ video_gen_id }} {
    width: 80px;
    height: 80px;
    margin: 0 auto 20px;
    opacity: 0.3;
  }

  .video-video-gallery__empty-text-{{ video_gen_id }} {
    font-size: 16px;
    color: #666;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .video-video-gallery__slide-{{ video_gen_id }} {
      flex: 0 0 calc((100% - ({{ section.settings.videos_per_row_tablet | minus: 1 }} * {{ section.settings.video_gap }}px)) / {{ section.settings.videos_per_row_tablet }});
    }
  }

  @media screen and (max-width: 749px) {
    .video-video-gallery-{{ video_gen_id }} {
      width: 100%;
    }

    .video-video-gallery__slide-{{ video_gen_id }} {
      flex: 0 0 calc((100% - ({{ section.settings.videos_per_row_mobile | minus: 1 }} * {{ section.settings.video_gap }}px)) / {{ section.settings.videos_per_row_mobile }});
    }

    .video-video-gallery__heading-{{ video_gen_id }} {
      font-size: calc({{ section.settings.heading_size }}px * 0.8);
    }
  }
{% endstyle %}

<product-video-gallery-{{ video_gen_id }} class="video-video-gallery-{{ video_gen_id }}" {{ section.shopify_attributes }}>
  <div class="video-video-gallery__contvideoner-{{ video_gen_id }}">

    {% if section.settings.heading != blank %}
      <h2 class="video-video-gallery__heading-{{ video_gen_id }}">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <h2 class="video-video-gallery__description-{{ video_gen_id }}">
        {{ section.settings.description }}
      </h2>
    {% endif %}

    {% assign gallery = product.metafields.custom.product_video_gallery.value %}

    {% if gallery != blank and gallery.children != blank %}

      {% assign raw_videos = gallery.children[0].children[0].value %}
      {% assign video_list = raw_videos | split: ';' %}

      {% assign valid_video_count = 0 %}
      {% for video in video_list %}
        {% assign video_url = video | strip %}
        {% if video_url != blank %}
          {% assign valid_video_count = valid_video_count | plus: 1 %}
        {% endif %}
      {% endfor %}

      {% if valid_video_count > 0 %}

        <div class="video-video-gallery__carousel-{{ video_gen_id }}">
          <div class="video-video-gallery__track-{{ video_gen_id }}" data-track>

            {% for video in video_list %}
              {% assign video_url = video | strip %}

              {% if video_url != blank %}
                <div class="video-video-gallery__slide-{{ video_gen_id }}">
                  <div class="video-video-gallery__video-wrapper-{{ video_gen_id }}">
                    <video
                      class="video-video-gallery__video-{{ video_gen_id }}"
                      {% if section.settings.autoplay %} autoplay {% endif %}
                      {% if section.settings.loop %} loop {% endif %}
                      {% if section.settings.muted %} muted {% endif %}
                      {% if section.settings.show_controls %} controls {% endif %}
                      playsinline
                      preload="metadata"
                    >
                      <source src="{{ video_url }}" type="video/mp4">
                    </video>
                  </div>
                </div>
              {% endif %}

            {% endfor %}

          </div>
        </div>

        {% if section.settings.show_navigation %}
          <div class="video-video-gallery__controls-{{ video_gen_id }}">
            
            <button class="video-video-gallery__button-{{ video_gen_id }}" data-prev aria-label="Previous videos">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>

            {% if section.settings.show_dots %}
              <div class="video-video-gallery__dots-{{ video_gen_id }}" data-dots></div>
            {% endif %}

            <button class="video-video-gallery__button-{{ video_gen_id }}" data-next aria-label="Next videos">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>

          </div>
        {% endif %}

      {% else %}
        <div class="video-video-gallery__empty-state-{{ video_gen_id }}">
          <p class="video-video-gallery__empty-text-{{ video_gen_id }}">
            No valid videos found in metafield.
          </p>
        </div>
      {% endif %}

    {% else %}
      <div class="video-video-gallery__empty-state-{{ video_gen_id }}">
        <p class="video-video-gallery__empty-text-{{ video_gen_id }}">
          Add videos to metafield: custom.product_video_gallery
        </p>
      </div>
    {% endif %}

  </div>
</product-video-gallery-{{ video_gen_id }}>

<script>
(function() {
  class ProductVideoGallery{{ video_gen_id }} extends HTMLElement {
    constructor() {
      super();
      this.currentIndex = 0;
      this.videosPerView = {{ section.settings.videos_per_row_desktop | default: 3 }};
      this.autoplayEnabled = {{ section.settings.enable_autoplay | default: false }};
      this.autoplayInterval = {{ section.settings.autoplay_interval | times: 1000 | default: 3000 }};
      this.autoplayTimer = null;
    }

    connectedCallback() {
      this.track = this.querySelector('[data-track]');
      this.prevButton = this.querySelector('[data-prev]');
      this.nextButton = this.querySelector('[data-next]');
      this.dotsContainer = this.querySelector('[data-dots]');

      if (!this.track) return;

      this.slides = Array.from(this.track.children);
      this.totalSlides = this.slides.length;

      this.updateVideosPerView();
      this.setupEventListeners();
      this.createDots();
      this.updateCarousel();

      if (this.autoplayEnabled && this.totalSlides > this.videosPerView) {
        this.startAutoplay();
      }
    }

    disconnectedCallback() {
      this.stopAutoplay();
      window.removeEventListener('resize', this.handleResize);
    }

    updateVideosPerView() {
      const width = window.innerWidth;
      if (width <= 749) {
        this.videosPerView = {{ section.settings.videos_per_row_mobile | default: 1 }};
      } else if (width <= 989) {
        this.videosPerView = {{ section.settings.videos_per_row_tablet | default: 2 }};
      } else {
        this.videosPerView = {{ section.settings.videos_per_row_desktop | default: 3 }};
      }
    }

    setupEventListeners() {
      if (this.prevButton) this.prevButton.addEventListener('click', () => { this.goToPrevious(); });
      if (this.nextButton) this.nextButton.addEventListener('click', () => { this.goToNext(); });

      this.handleResize = () => {
        const oldVideosPerView = this.videosPerView;
        this.updateVideosPerView();
        if (oldVideosPerView !== this.videosPerView) {
          this.currentIndex = 0;
          this.createDots();
          this.updateCarousel();
        }
      };
      window.addEventListener('resize', this.handleResize);

      this.addEventListener('mouseenter', () => this.stopAutoplay());
      this.addEventListener('mouseleave', () => {
        if (this.autoplayEnabled && this.totalSlides > this.videosPerView) this.startAutoplay();
      });
    }

    createDots() {
      if (!this.dotsContainer) return;
      this.dotsContainer.innerHTML = '';
      const maxIndex = Math.max(0, this.totalSlides - this.videosPerView);
      const totalDots = maxIndex + 1;
      for (let i = 0; i < totalDots; i++) {
        const dot = document.createElement('button');
        dot.className = 'video-video-gallery__dot-{{ video_gen_id }}';
        dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
        dot.addEventListener('click', () => this.goToSlide(i));
        this.dotsContainer.appendChild(dot);
      }
      this.dots = Array.from(this.dotsContainer.children);
    }

    updateCarousel() {
      if (!this.slides.length) return;
      const maxIndex = Math.max(0, this.totalSlides - this.videosPerView);
      this.currentIndex = Math.min(this.currentIndex, maxIndex);

      const slideWidth = this.slides[0].offsetWidth;
      const gap = {{ section.settings.video_gap | default: 10 }};
      const offset = -(this.currentIndex * (slideWidth + gap));

      this.track.style.transform = `translateX(${offset}px)`;
      this.track.style.transition = 'transform 0.4s ease';

      if (this.prevButton) this.prevButton.disabled = this.currentIndex === 0;
      if (this.nextButton) this.nextButton.disabled = this.currentIndex >= maxIndex;

      if (this.dots) this.dots.forEach((dot, i) => dot.classList.toggle('active', i === this.currentIndex));
    }

    goToPrevious() {
      if (this.currentIndex > 0) this.currentIndex--;
      this.updateCarousel();
    }

    goToNext() {
      const maxIndex = Math.max(0, this.totalSlides - this.videosPerView);
      if (this.currentIndex < maxIndex) this.currentIndex++;
      this.updateCarousel();
    }

    goToSlide(index) {
      this.currentIndex = index;
      this.updateCarousel();
    }

    startAutoplay() {
      this.stopAutoplay();
      this.autoplayTimer = setInterval(() => {
        const maxIndex = Math.max(0, this.totalSlides - this.videosPerView);
        this.currentIndex = this.currentIndex >= maxIndex ? 0 : this.currentIndex + 1;
        this.updateCarousel();
      }, this.autoplayInterval);
    }

    stopAutoplay() {
      if (this.autoplayTimer) {
        clearInterval(this.autoplayTimer);
        this.autoplayTimer = null;
      }
    }
  }

  customElements.define('product-video-gallery-{{ video_gen_id }}', ProductVideoGallery{{ video_gen_id }});
})();
</script>

{% schema %}
{
  "name": "PDP product video gallery",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product videos"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Product videos"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 28
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Heading spacing",
      "default": 24
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section padding",
      "default": 40
    },
    {
      "type": "select",
      "id": "videos_per_row_desktop",
      "label": "Videos per row (desktop)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "videos_per_row_tablet",
      "label": "Videos per row (tablet)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "videos_per_row_mobile",
      "label": "Videos per row (mobile)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "video_gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Gap between videos",
      "default": 16
    },
    {
      "type": "header",
      "content": "Video settings"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay videos",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop videos",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "Mute videos",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show video controls",
      "default": true
    },
    {
      "type": "color",
      "id": "video_background",
      "label": "Video background",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "video_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Video border radius",
      "default": 10
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show navigation",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    },
    {
      "type": "range",
      "id": "controls_spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Controls spacing",
      "default": 24
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button hover background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button icon color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "dot_active_color",
      "label": "Active dot color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Autoplay carousel"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable carousel autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay interval",
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "PDP Product video gallery"
    }
  ]
}
{% endschema %}
