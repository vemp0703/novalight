{% assign section_id = section.id | default: 'product-video-gallery' %}

{% style %}
.ai-video-gallery-{{ section_id }} {
  display: block;
  width: {{ section.settings.desktop_width_percent }}%;
  max-width: 100%;
  margin: 0 auto;
  padding: {{ section.settings.section_padding }}px 0;
}

.ai-video-gallery__container-{{ section_id }} { position: relative; width: 100%; }

.ai-video-gallery__heading-{{ section_id }} {
  text-align: {{ section.settings.heading_alignment }};
  margin-bottom: {{ section.settings.heading_spacing }}px;
  font-size: {{ section.settings.heading_size }}px;
  color: {{ section.settings.heading_color }};
}

.ai-video-gallery__description-{{ section_id }} {
  text-align: {{ section.settings.heading_alignment }};
  margin-bottom: {{ section.settings.heading_spacing }}px;
  font-size: 18px;
  color: {{ section.settings.heading_color }};
}

.ai-video-gallery__carousel-{{ section_id }} {
  position: relative;
  overflow: hidden;
  border-radius: {{ section.settings.video_border_radius }}px;
}

.ai-video-gallery__track-{{ section_id }} {
  display: flex;
  gap: {{ section.settings.video_gap }}px;
  transition: transform 0.4s ease;
}

.ai-video-gallery__slide-{{ section_id }} {
  flex: 0 0 calc((100% - ({{ section.settings.videos_per_row_desktop | minus: 1 }} * {{ section.settings.video_gap }}px)) / {{ section.settings.videos_per_row_desktop }});
  position: relative;
  background-color: {{ section.settings.video_background }};
  border-radius: {{ section.settings.video_border_radius }}px;
  overflow: hidden;
}

.ai-video-gallery__video-wrapper-{{ section_id }} {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%;
  background-color: #000;
  border-radius: {{ section.settings.video_border_radius }}px;
  overflow: hidden;
  min-height: 450px;
}

.ai-video-gallery__video-{{ section_id }} {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.ai-video-gallery__controls-{{ section_id }} {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16px;
  margin-top: {{ section.settings.controls_spacing }}px;
}

.ai-video-gallery__button-{{ section_id }} {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background-color: {{ section.settings.button_background }};
  color: {{ section.settings.button_color }};
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.ai-video-gallery__button-{{ section_id }}:hover:not(:disabled) {
  background-color: {{ section.settings.button_hover_background }};
  transform: scale(1.1);
}

.ai-video-gallery__button-{{ section_id }}:disabled {
  opacity: 0.3;
  cursor: not-allowed;
}

.ai-video-gallery__button-{{ section_id }} svg { width: 20px; height: 20px; }

.ai-video-gallery__dots-{{ section_id }} {
  display: flex;
  gap: 8px;
}

.ai-video-gallery__dot-{{ section_id }} {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background-color: {{ section.settings.dot_color }};
  opacity: 0.3;
  border: none;
  cursor: pointer;
  padding: 0;
  transition: all 0.3s ease;
}

.ai-video-gallery__dot-{{ section_id }}.active {
  opacity: 1;
  background-color: {{ section.settings.dot_active_color }};
}

.ai-video-gallery__empty-state-{{ section_id }} {
  text-align: center;
  padding: 60px 20px;
  background-color: #f4f4f4;
  border-radius: {{ section.settings.video_border_radius }}px;
}

.ai-video-gallery__empty-text-{{ section_id }} {
  font-size: 16px;
  color: #666;
  margin: 0;
}

@media screen and (max-width: 989px) {
  .ai-video-gallery__slide-{{ section_id }} {
    flex: 0 0 calc((100% - ({{ section.settings.videos_per_row_tablet | minus: 1 }} * {{ section.settings.video_gap }}px)) / {{ section.settings.videos_per_row_tablet }});
  }
}

@media screen and (max-width: 749px) {
  .ai-video-gallery-{{ section_id }} { width: 100%; }
  .ai-video-gallery__slide-{{ section_id }} {
    flex: 0 0 calc((100% - ({{ section.settings.videos_per_row_mobile | minus: 1 }} * {{ section.settings.video_gap }}px)) / {{ section.settings.videos_per_row_mobile }});
  }
  .ai-video-gallery__heading-{{ section_id }} {
    font-size: calc({{ section.settings.heading_size }}px * 0.8);
  }
}
{% endstyle %}

<product-video-gallery-{{ section_id }} class="ai-video-gallery-{{ section_id }}">
  <div class="ai-video-gallery__container-{{ section_id }}">
    {% if section.settings.heading != blank %}
      <h2 class="ai-video-gallery__heading-{{ section_id }}">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.description != blank %}
      <p class="ai-video-gallery__description-{{ section_id }}">{{ section.settings.description }}</p>
    {% endif %}

    {% assign raw_videos = product.metafields.custom.product_video_gallery | default: '' %}
    {% assign video_list = raw_videos | split: ';' | map: 'strip' %}
    {% assign valid_video_count = video_list | where: "size", ">", 0 | size %}

    {% if valid_video_count > 0 %}
      <div class="ai-video-gallery__carousel-{{ section_id }}">
        <div class="ai-video-gallery__track-{{ section_id }}" data-track>
          {% for video_url in video_list %}
            {% if video_url != blank %}
              <div class="ai-video-gallery__slide-{{ section_id }}">
                <div class="ai-video-gallery__video-wrapper-{{ section_id }}">
                  <video class="ai-video-gallery__video-{{ section_id }}"
                    {% if section.settings.autoplay %} autoplay {% endif %}
                    {% if section.settings.loop %} loop {% endif %}
                    {% if section.settings.muted %} muted {% endif %}
                    {% if section.settings.show_controls %} controls {% endif %}
                    playsinline preload="metadata">
                    <source src="{{ video_url }}" type="video/mp4">
                  </video>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      {% if section.settings.show_navigation %}
        <div class="ai-video-gallery__controls-{{ section_id }}">
          <button class="ai-video-gallery__button-{{ section_id }}" data-prev aria-label="Previous videos">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>

          {% if section.settings.show_dots %}
            <div class="ai-video-gallery__dots-{{ section_id }}" data-dots></div>
          {% endif %}

          <button class="ai-video-gallery__button-{{ section_id }}" data-next aria-label="Next videos">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      {% endif %}

    {% else %}
      <div class="ai-video-gallery__empty-state-{{ section_id }}">
        <p class="ai-video-gallery__empty-text-{{ section_id }}">
          Add videos to metafield: custom.product_video_gallery
        </p>
      </div>
    {% endif %}
  </div>
</product-video-gallery-{{ section_id }}>

<script>
(function() {
  class ProductVideoGallery{{ section_id }} extends HTMLElement {
    constructor() {
      super();
      this.currentIndex = 0;
      this.videosPerView = {{ section.settings.videos_per_row_desktop }};
      this.autoplayEnabled = {{ section.settings.enable_autoplay | json }};
      this.autoplayInterval = {{ section.settings.autoplay_interval | times: 1000 }};
      this.autoplayTimer = null;
    }
    connectedCallback() {
      this.track = this.querySelector('[data-track]');
      this.prevButton = this.querySelector('[data-prev]');
      this.nextButton = this.querySelector('[data-next]');
      this.dotsContainer = this.querySelector('[data-dots]');
      if (!this.track) return;
      this.slides = Array.from(this.track.children);
      this.totalSlides = this.slides.length;
      this.updateVideosPerView();
      this.setupEventListeners();
      this.createDots();
      this.updateCarousel();
      if (this.autoplayEnabled && this.totalSlides > this.videosPerView) this.startAutoplay();
    }
    disconnectedCallback() { this.stopAutoplay(); window.removeEventListener('resize', this.handleResize); }
    updateVideosPerView() {
      const width = window.innerWidth;
      if (width <= 749) this.videosPerView = {{ section.settings.videos_per_row_mobile }};
      else if (width <= 989) this.videosPerView = {{ section.settings.videos_per_row_tablet }};
      else this.videosPerView = {{ section.settings.videos_per_row_desktop }};
    }
    setupEventListeners() {
      if (this.prevButton) this.prevButton.addEventListener('click', () => { this.stopAutoplay(); this.goToPrevious(); if(this.autoplayEnabled) this.startAutoplay(); });
      if (this.nextButton) this.nextButton.addEventListener('click', () => { this.stopAutoplay(); this.goToNext(); if(this.autoplayEnabled) this.startAutoplay(); });
      this.handleResize = () => { const oldVideos = this.videosPerView; this.updateVideosPerView(); if(oldVideos !== this.videosPerView){ this.currentIndex=0; this.createDots(); this.updateCarousel(); } };
      window.addEventListener('resize', this.handleResize);
      this.addEventListener('mouseenter', () => this.stopAutoplay());
      this.addEventListener('mouseleave', () => { if(this.autoplayEnabled && this.totalSlides>this.videosPerView) this.startAutoplay(); });
    }
    createDots() {
      if (!this.dotsContainer) return;
      this.dotsContainer.innerHTML = '';
      const maxIndex = Math.max(0,this.totalSlides-this.videosPerView);
      const totalDots = maxIndex+1;
      for(let i=0;i<totalDots;i++){
        const dot=document.createElement('button');
        dot.className='ai-video-gallery__dot-{{ section_id }}';
        dot.setAttribute('aria-label',`Go to slide ${i+1}`);
        dot.addEventListener('click',()=>{ this.stopAutoplay(); this.goToSlide(i); if(this.autoplayEnabled) this.startAutoplay(); });
        this.dotsContainer.appendChild(dot);
      }
      this.dots=Array.from(this.dotsContainer.children);
    }
    updateCarousel(){
      const maxIndex=Math.max(0,this.totalSlides-this.videosPerView);
      this.currentIndex=Math.min(this.currentIndex,maxIndex);
      const slideWidth=this.slides[0].offsetWidth;
      const gap={{ section.settings.video_gap }};
      const offset=-(this.currentIndex*(slideWidth+gap));
      this.track.style.transform=`translateX(${offset}px)`;
      if(this.prevButton) this.prevButton.disabled=this.currentIndex===0;
      if(this.nextButton) this.nextButton.disabled=this.currentIndex>=maxIndex;
      if(this.dots) this.dots.forEach((dot,index)=>{ dot.classList.toggle('active', index===this.currentIndex); });
    }
    goToPrevious(){ if(this.currentIndex>0){ this.currentIndex--; this.updateCarousel(); } }
    goToNext(){ const maxIndex=Math.max(0,this.totalSlides-this.videosPerView); if(this.currentIndex<maxIndex){ this.currentIndex++; this.updateCarousel(); } }
    goToSlide(index){ this.currentIndex=index; this.updateCarousel(); }
    startAutoplay(){ this.stopAutoplay(); this.autoplayTimer=setInterval(()=>{ const maxIndex=Math.max(0,this.totalSlides-this.videosPerView); if(this.currentIndex>=maxIndex) this.currentIndex=0; else this.currentIndex++; this.updateCarousel(); }, this.autoplayInterval);}
    stopAutoplay(){ if(this.autoplayTimer){ clearInterval(this.autoplayTimer); this.autoplayTimer=null; } }
  }
  customElements.define('product-video-gallery-{{ section_id }}', ProductVideoGallery{{ section_id }});
})();
</script>