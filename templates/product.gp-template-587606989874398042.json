        "checksum": "d92535789423237e1a4572872c4481fcc8effe8774ed766fa5b86e1a263eb54f_1_1_1_0__1",
        "gggk88p1qOk_text": "Over 10 years of scientific research !",
        "gggVPddRcVo_text": "The Regenmask™ utilizes recognized and NASA-used therapeutic LED technology. It offers you a safe and cost-effective solution to all your anti-aging and acne woes. It is simple, convenient, and totally safe.",
        "ggxJuPEXEny_text": "We use the most clinically effective LEDs available!",
        "ggPgi1ZFXKV_text": "In just 15 to 30 minutes a day, you can embrace a whole new you!",
        "ggkXhOA3e_l_text": "<p>of users saw smoother skin with reduced wrinkles and fine lines</p>",
        "gg78puxOszH_text": "<p>noticed enhanced skin tone and overall smoothness</p>",
        "ggcZZb3WoOB_leftImageLabel": "Before",
        "ggcZZb3WoOB_rightImageLabel": "After"
      }
    },
