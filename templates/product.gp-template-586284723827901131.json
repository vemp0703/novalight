        "ggXUHMCmkKu_unlimitedQuantityMessage": "In Stock!",
        "gg5Sj0txQqL_text": "<p>NOVALIGHT™ Regenmask 2.0 is an advanced LED therapy mask engineered for targeted skincare support with professional-level settings.</p>",
        "ggjXdQwyFf1_text": "Quantity",
        "ggi2r2UxnVt_label": "Add to cart",
