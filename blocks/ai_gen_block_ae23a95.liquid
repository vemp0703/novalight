{% doc %}
  @prompt
    clone the section image with text the only change i want is insted of image i want video
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-text-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-video-text-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.spacing }}px;
    align-items: center;
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
  }

  .ai-video-text-container-{{ ai_gen_id }}.ai-video-text-layout-video-first-{{ ai_gen_id }} {
    grid-template-areas: "video content";
  }

  .ai-video-text-container-{{ ai_gen_id }}.ai-video-text-layout-text-first-{{ ai_gen_id }} {
    grid-template-areas: "content video";
  }

  .ai-video-text-media-{{ ai_gen_id }} {
    grid-area: video;
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.media_radius }}px;
  }

  .ai-video-text-video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-video-text-placeholder-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.media_radius }}px;
  }

  .ai-video-text-placeholder-{{ ai_gen_id }} svg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60%;
    height: 60%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-video-text-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-video-text-content-{{ ai_gen_id }} {
    grid-area: content;
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-video-text-heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  .ai-video-text-text-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.text_spacing }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
  }

  .ai-video-text-text-{{ ai_gen_id }} p {
    margin: 0 0 1em;
  }

  .ai-video-text-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-video-text-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    transition: background-color 0.3s ease;
  }

  .ai-video-text-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_background_hover }};
  }

  @media screen and (max-width: 749px) {
    .ai-video-text-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      grid-template-areas: 
        "video"
        "content" !important;
      gap: {{ block.settings.spacing_mobile }}px;
    }

    .ai-video-text-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-video-text-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.9);
    }
  }
{% endstyle %}

<video-with-text-{{ ai_gen_id }} class="ai-video-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-text-container-{{ ai_gen_id }} ai-video-text-layout-{{ block.settings.layout }}-{{ ai_gen_id }}">
    <div class="ai-video-text-media-{{ ai_gen_id }}">
      {% if block.settings.video %}
        <video
          class="ai-video-text-video-{{ ai_gen_id }}"
          {% if block.settings.autoplay %}autoplay{% endif %}
          {% if block.settings.loop %}loop{% endif %}
          {% if block.settings.muted %}muted{% endif %}
          {% if block.settings.controls %}controls{% endif %}
          playsinline
        >
          {% for source in block.settings.video.sources %}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {% endfor %}
        </video>
      {% elsif block.settings.video_url != blank %}
        {% if block.settings.video_url contains 'youtube.com' or block.settings.video_url contains 'youtu.be' %}
          {% assign video_id = block.settings.video_url | split: 'v=' | last | split: '/' | last | split: '&' | first %}
          <iframe
            class="ai-video-text-video-{{ ai_gen_id }}"
            src="https://www.youtube.com/embed/{{ video_id }}?autoplay={{ block.settings.autoplay }}&loop={{ block.settings.loop }}&mute={{ block.settings.muted }}&controls={{ block.settings.controls }}"
            frameborder="0"
            allow="autoplay; encrypted-media"
            allowfullscreen
            style="aspect-ratio: 16/9;"
          ></iframe>
        {% elsif block.settings.video_url contains 'vimeo.com' %}
          {% assign video_id = block.settings.video_url | split: '/' | last %}
          <iframe
            class="ai-video-text-video-{{ ai_gen_id }}"
            src="https://player.vimeo.com/video/{{ video_id }}?autoplay={{ block.settings.autoplay }}&loop={{ block.settings.loop }}&muted={{ block.settings.muted }}"
            frameborder="0"
            allow="autoplay; fullscreen"
            allowfullscreen
            style="aspect-ratio: 16/9;"
          ></iframe>
        {% endif %}
      {% else %}
        <div class="ai-video-text-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-video-text-empty-state-{{ ai_gen_id }}">
            Next, add a video
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-video-text-content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-video-text-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="ai-video-text-text-{{ ai_gen_id }}">
          {{ block.settings.text }}
        </div>
      {% endif %}

      {% if block.settings.button_label != blank and block.settings.button_link != blank %}
        <a href="{{ block.settings.button_link }}" class="ai-video-text-button-{{ ai_gen_id }}">
          {{ block.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</video-with-text-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoWithText{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const video = this.querySelector('.ai-video-text-video-{{ ai_gen_id }}');
        if (video && video.tagName === 'VIDEO') {
          video.addEventListener('loadedmetadata', () => {
            if (video.videoWidth && video.videoHeight) {
              video.style.aspectRatio = `${video.videoWidth} / ${video.videoHeight}`;
            }
          });
        }
      }
    }

    customElements.define('video-with-text-{{ ai_gen_id }}', VideoWithText{{ ai_gen_id }});
  })();
</script>

