{% doc %}
  @prompt
    Generate Product video gallery which needs to be responsive. In every product I have a metafeild custom.product_video_gallery and I want the section take it as dynamic source for video carousel make sure it responsive it is very important
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-gallery-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-video-gallery__container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-video-gallery__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-video-gallery__carousel-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.video_border_radius }}px;
  }

  .ai-video-gallery__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.video_gap }}px;
    transition: transform 0.4s ease;
  }

  .ai-video-gallery__slide-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.videos_per_row_desktop | minus: 1 }} * {{ block.settings.video_gap }}px)) / {{ block.settings.videos_per_row_desktop }});
    position: relative;
    background-color: {{ block.settings.video_background }};
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
  }

  .ai-video-gallery__video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    background-color: #000;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
  }

  .ai-video-gallery__video-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-gallery__controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: {{ block.settings.controls_spacing }}px;
  }

  .ai-video-gallery__button-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-video-gallery__button-{{ ai_gen_id }}:hover:not(:disabled) {
    background-color: {{ block.settings.button_hover_background }};
    transform: scale(1.1);
  }

  .ai-video-gallery__button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-video-gallery__button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-video-gallery__dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-video-gallery__dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.3;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }

  .ai-video-gallery__dot-{{ ai_gen_id }}.active {
    opacity: 1;
    background-color: {{ block.settings.dot_active_color }};
  }

  .ai-video-gallery__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.video_border_radius }}px;
  }

  .ai-video-gallery__empty-icon-{{ ai_gen_id }} {
    width: 80px;
    height: 80px;
    margin: 0 auto 20px;
    opacity: 0.3;
  }

  .ai-video-gallery__empty-text-{{ ai_gen_id }} {
    font-size: 16px;
    color: #666;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-video-gallery__slide-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.videos_per_row_tablet | minus: 1 }} * {{ block.settings.video_gap }}px)) / {{ block.settings.videos_per_row_tablet }});
    }
  }

  @media screen and (max-width: 749px) {
    .ai-video-gallery-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-video-gallery__slide-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.videos_per_row_mobile | minus: 1 }} * {{ block.settings.video_gap }}px)) / {{ block.settings.videos_per_row_mobile }});
    }

    .ai-video-gallery__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }
{% endstyle %}

<product-video-gallery-{{ ai_gen_id }} class="ai-video-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-gallery__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-video-gallery__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if product.metafields.custom.product_video_gallery.value != blank %}
      <div class="ai-video-gallery__carousel-{{ ai_gen_id }}">
        <div class="ai-video-gallery__track-{{ ai_gen_id }}" data-track>
          {% for video in product.metafields.custom.product_video_gallery %}

          {{ video | json }}
            <div class="ai-video-gallery__slide-{{ ai_gen_id }}">
              <div class="ai-video-gallery__video-wrapper-{{ ai_gen_id }}">
                {{ video | video_tag: 
                  class: 'ai-video-gallery__video-' | append: ai_gen_id,
                  autoplay: block.settings.autoplay,
                  loop: block.settings.loop,
                  muted: block.settings.muted,
                  controls: block.settings.show_controls
                }}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      {% if block.settings.show_navigation %}
        <div class="ai-video-gallery__controls-{{ ai_gen_id }}">
          <button 
            class="ai-video-gallery__button-{{ ai_gen_id }}" 
            data-prev
            aria-label="Previous videos"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>

          {% if block.settings.show_dots %}
            <div class="ai-video-gallery__dots-{{ ai_gen_id }}" data-dots></div>
          {% endif %}

          <button 
            class="ai-video-gallery__button-{{ ai_gen_id }}" 
            data-next
            aria-label="Next videos"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      {% endif %}
    {% else %}
      <div class="ai-video-gallery__empty-state-{{ ai_gen_id }}">
        <div class="ai-video-gallery__empty-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="23 7 16 12 23 17 23 7"></polygon>
            <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
          </svg>
        </div>
        <p class="ai-video-gallery__empty-text-{{ ai_gen_id }}">
          Add videos to the product metafield: custom.product_video_gallery
        </p>
      </div>
    {% endif %}
  </div>
</product-video-gallery-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductVideoGallery{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.videosPerView = {{ block.settings.videos_per_row_desktop }};
        this.autoplayEnabled = {{ block.settings.enable_autoplay }};
        this.autoplayInterval = {{ block.settings.autoplay_interval | times: 1000 }};
        this.autoplayTimer = null;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.dotsContainer = this.querySelector('[data-dots]');
        
        if (!this.track) return;

        this.slides = Array.from(this.track.children);
        this.totalSlides = this.slides.length;

        this.updateVideosPerView();
        this.setupEventListeners();
        this.createDots();
        this.updateCarousel();

        if (this.autoplayEnabled && this.totalSlides > this.videosPerView) {
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
        window.removeEventListener('resize', this.handleResize);
      }

      updateVideosPerView() {
        const width = window.innerWidth;
        if (width <= 749) {
          this.videosPerView = {{ block.settings.videos_per_row_mobile }};
        } else if (width <= 989) {
          this.videosPerView = {{ block.settings.videos_per_row_tablet }};
        } else {
          this.videosPerView = {{ block.settings.videos_per_row_desktop }};
        }
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => {
            this.stopAutoplay();
            this.goToPrevious();
            if (this.autoplayEnabled) this.startAutoplay();
          });
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => {
            this.stopAutoplay();
            this.goToNext();
            if (this.autoplayEnabled) this.startAutoplay();
          });
        }

        this.handleResize = () => {
          const oldVideosPerView = this.videosPerView;
          this.updateVideosPerView();
          if (oldVideosPerView !== this.videosPerView) {
            this.currentIndex = 0;
            this.createDots();
            this.updateCarousel();
          }
        };

        window.addEventListener('resize', this.handleResize);

        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => {
          if (this.autoplayEnabled && this.totalSlides > this.videosPerView) {
            this.startAutoplay();
          }
        });
      }

      createDots() {
        if (!this.dotsContainer) return;

        this.dotsContainer.innerHTML = '';
        const maxIndex = Math.max(0, this.totalSlides - this.videosPerView);
        const totalDots = maxIndex + 1;

        for (let i = 0; i < totalDots; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-video-gallery__dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          dot.addEventListener('click', () => {
            this.stopAutoplay();
            this.goToSlide(i);
            if (this.autoplayEnabled) this.startAutoplay();
          });
          this.dotsContainer.appendChild(dot);
        }

        this.dots = Array.from(this.dotsContainer.children);
      }

      updateCarousel() {
        const maxIndex = Math.max(0, this.totalSlides - this.videosPerView);
        this.currentIndex = Math.min(this.currentIndex, maxIndex);

        const slideWidth = this.slides[0].offsetWidth;
        const gap = {{ block.settings.video_gap }};
        const offset = -(this.currentIndex * (slideWidth + gap));
        
        this.track.style.transform = `translateX(${offset}px)`;

        if (this.prevButton) {
          this.prevButton.disabled = this.currentIndex === 0;
        }

        if (this.nextButton) {
          this.nextButton.disabled = this.currentIndex >= maxIndex;
        }

        if (this.dots) {
          this.dots.forEach((dot, index) => {
            dot.classList.toggle('active', index === this.currentIndex);
          });
        }
      }

      goToPrevious() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateCarousel();
        }
      }

      goToNext() {
        const maxIndex = Math.max(0, this.totalSlides - this.videosPerView);
        if (this.currentIndex < maxIndex) {
          this.currentIndex++;
          this.updateCarousel();
        }
      }

      goToSlide(index) {
        this.currentIndex = index;
        this.updateCarousel();
      }

      startAutoplay() {
        this.stopAutoplay();
        this.autoplayTimer = setInterval(() => {
          const maxIndex = Math.max(0, this.totalSlides - this.videosPerView);
          if (this.currentIndex >= maxIndex) {
            this.currentIndex = 0;
          } else {
            this.currentIndex++;
          }
          this.updateCarousel();
        }, this.autoplayInterval);
      }

      stopAutoplay() {
        if (this.autoplayTimer) {
          clearInterval(this.autoplayTimer);
          this.autoplayTimer = null;
        }
      }
    }

    customElements.define('product-video-gallery-{{ ai_gen_id }}', ProductVideoGallery{{ ai_gen_id }});
  })();
</script>

