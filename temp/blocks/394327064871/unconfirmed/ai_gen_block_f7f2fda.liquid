{% doc %}
  @prompt
    Create the product video carousel, I provide the data in list form and then properly arrange the videos. and also make the section responsive , for videos I will use dynamic source, i have metafeild in the backend which is text rich and I will supply all the video links using ; as seprator and I want you  to process those data as video causal 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-video-carousel__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-video-carousel__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 30px;
  }

  .ai-video-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 10px;
  }

  .ai-video-carousel__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
  }

  .ai-video-carousel__wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-video-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap_between_videos }}px;
    transition: transform 0.5s ease;
  }

  .ai-video-carousel__slide-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.videos_per_row_desktop | minus: 1 }} * {{ block.settings.gap_between_videos }}px)) / {{ block.settings.videos_per_row_desktop }});
    min-width: 0;
  }

  .ai-video-carousel__video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    background-color: #000;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
  }

  .ai-video-carousel__video-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .ai-video-carousel__controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 30px;
  }

  .ai-video-carousel__button-{{ ai_gen_id }} {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  .ai-video-carousel__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-video-carousel__button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-video-carousel__button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-video-carousel__dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-video-carousel__dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    padding: 0;
    opacity: 0.3;
    transition: opacity 0.3s ease;
  }

  .ai-video-carousel__dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-video-carousel__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.video_border_radius }}px;
  }

  .ai-video-carousel__empty-state-{{ ai_gen_id }} svg {
    width: 100px;
    height: 100px;
    margin-bottom: 20px;
    opacity: 0.3;
  }

  .ai-video-carousel__empty-text-{{ ai_gen_id }} {
    font-size: 16px;
    color: #666;
  }

  @media screen and (max-width: 989px) {
    .ai-video-carousel__slide-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.videos_per_row_tablet | minus: 1 }} * {{ block.settings.gap_between_videos }}px)) / {{ block.settings.videos_per_row_tablet }});
    }

    .ai-video-carousel__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-video-carousel__description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-video-carousel__slide-{{ ai_gen_id }} {
      flex: 0 0 100%;
    }

    .ai-video-carousel__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }

    .ai-video-carousel__description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.85);
    }

    .ai-video-carousel__button-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
    }

    .ai-video-carousel__button-{{ ai_gen_id }} svg {
      width: 16px;
      height: 16px;
    }
  }
{% endstyle %}

<product-video-carousel-{{ ai_gen_id }} class="ai-video-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-carousel__container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.description != blank %}
      <div class="ai-video-carousel__header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-video-carousel__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="ai-video-carousel__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.video_metafield != blank and product.metafields[block.settings.video_metafield] != blank %}
      {% assign metafield_value = product.metafields[block.settings.video_metafield].value | strip_html | strip %}
      {% assign video_urls = metafield_value | split: ';' %}
      {% assign video_count = 0 %}
      
      {% for url in video_urls %}
        {% assign trimmed_url = url | strip %}
        {% if trimmed_url != blank %}
          {% assign video_count = video_count | plus: 1 %}
        {% endif %}
      {% endfor %}

      {% if video_count > 0 %}
        <div class="ai-video-carousel__wrapper-{{ ai_gen_id }}">
          <div class="ai-video-carousel__track-{{ ai_gen_id }}">
            {% for url in video_urls %}
              {% assign trimmed_url = url | strip %}
              {% if trimmed_url != blank %}
                <div class="ai-video-carousel__slide-{{ ai_gen_id }}">
                  <div class="ai-video-carousel__video-wrapper-{{ ai_gen_id }}">
                    {% if trimmed_url contains 'youtube.com' or trimmed_url contains 'youtu.be' %}
                      {% if trimmed_url contains 'youtu.be/' %}
                        {% assign video_id = trimmed_url | split: 'youtu.be/' | last | split: '?' | first %}
                      {% elsif trimmed_url contains 'watch?v=' %}
                        {% assign video_id = trimmed_url | split: 'watch?v=' | last | split: '&' | first %}
                      {% elsif trimmed_url contains 'embed/' %}
                        {% assign video_id = trimmed_url | split: 'embed/' | last | split: '?' | first %}
                      {% else %}
                        {% assign video_id = '' %}
                      {% endif %}
                      {% if video_id != blank %}
                        <iframe
                          class="ai-video-carousel__video-{{ ai_gen_id }}"
                          src="https://www.youtube.com/embed/{{ video_id }}"
                          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                          allowfullscreen
                          loading="lazy"
                        ></iframe>
                      {% endif %}
                    {% elsif trimmed_url contains 'vimeo.com' %}
                      {% assign video_id = trimmed_url | split: 'vimeo.com/' | last | split: '?' | first %}
                      {% if video_id != blank %}
                        <iframe
                          class="ai-video-carousel__video-{{ ai_gen_id }}"
                          src="https://player.vimeo.com/video/{{ video_id }}"
                          allow="autoplay; fullscreen; picture-in-picture"
                          allowfullscreen
                          loading="lazy"
                        ></iframe>
                      {% endif %}
                    {% else %}
                      <video
                        class="ai-video-carousel__video-{{ ai_gen_id }}"
                        controls
                        preload="metadata"
                      >
                        <source src="{{ trimmed_url }}" type="video/mp4">
                        Your browser does not support the video tag.
                      </video>
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        {% if block.settings.show_controls %}
          <div class="ai-video-carousel__controls-{{ ai_gen_id }}">
            <button class="ai-video-carousel__button-{{ ai_gen_id }} ai-video-carousel__prev-{{ ai_gen_id }}" aria-label="Previous">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>

            <div class="ai-video-carousel__dots-{{ ai_gen_id }}"></div>

            <button class="ai-video-carousel__button-{{ ai_gen_id }} ai-video-carousel__next-{{ ai_gen_id }}" aria-label="Next">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
        {% endif %}
      {% else %}
        <div class="ai-video-carousel__empty-state-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <p class="ai-video-carousel__empty-text-{{ ai_gen_id }}">No video URLs found in the metafield</p>
        </div>
      {% endif %}
    {% else %}
      <div class="ai-video-carousel__empty-state-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <p class="ai-video-carousel__empty-text-{{ ai_gen_id }}">Configure the video metafield to display videos</p>
      </div>
    {% endif %}
  </div>
</product-video-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductVideoCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.videosPerView = {{ block.settings.videos_per_row_desktop }};
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-video-carousel__track-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-video-carousel__slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-video-carousel__prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-video-carousel__next-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-video-carousel__dots-{{ ai_gen_id }}');

        if (!this.track || this.slides.length === 0) return;

        this.updateVideosPerView();
        this.createDots();
        this.setupEventListeners();
        this.updateCarousel();

        {% if block.settings.autoplay %}
          this.startAutoplay();
        {% endif %}

        window.addEventListener('resize', () => this.handleResize());
      }

      updateVideosPerView() {
        const width = window.innerWidth;
        if (width <= 749) {
          this.videosPerView = 1;
        } else if (width <= 989) {
          this.videosPerView = {{ block.settings.videos_per_row_tablet }};
        } else {
          this.videosPerView = {{ block.settings.videos_per_row_desktop }};
        }
      }

      get totalPages() {
        return Math.ceil(this.slides.length / this.videosPerView);
      }

      createDots() {
        if (!this.dotsContainer) return;
        this.dotsContainer.innerHTML = '';

        for (let i = 0; i < this.totalPages; i++) {
          const dot = document.createElement('button');
          dot.classList.add('ai-video-carousel__dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          if (i === 0) dot.classList.add('active');
          dot.addEventListener('click', () => this.goToPage(i));
          this.dotsContainer.appendChild(dot);
        }
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.prev());
        }
        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.next());
        }

        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => {
          {% if block.settings.autoplay %}
            this.startAutoplay();
          {% endif %}
        });
      }

      handleResize() {
        const oldVideosPerView = this.videosPerView;
        this.updateVideosPerView();
        
        if (oldVideosPerView !== this.videosPerView) {
          this.currentIndex = 0;
          this.createDots();
          this.updateCarousel();
        }
      }

      prev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateCarousel();
        }
      }

      next() {
        if (this.currentIndex < this.totalPages - 1) {
          this.currentIndex++;
          this.updateCarousel();
        }
      }

      goToPage(index) {
        this.currentIndex = index;
        this.updateCarousel();
      }

      updateCarousel() {
        const slideWidth = this.slides[0].offsetWidth;
        const gap = {{ block.settings.gap_between_videos }};
        const offset = -(this.currentIndex * this.videosPerView * (slideWidth + gap));
        
        this.track.style.transform = `translateX(${offset}px)`;

        if (this.prevButton) {
          this.prevButton.disabled = this.currentIndex === 0;
        }
        if (this.nextButton) {
          this.nextButton.disabled = this.currentIndex >= this.totalPages - 1;
        }

        this.updateDots();
      }

      updateDots() {
        if (!this.dotsContainer) return;
        const dots = this.dotsContainer.querySelectorAll('.ai-video-carousel__dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      startAutoplay() {
        this.stopAutoplay();
        this.autoplayInterval = setInterval(() => {
          if (this.currentIndex < this.totalPages - 1) {
            this.next();
          } else {
            this.currentIndex = 0;
            this.updateCarousel();
          }
        }, {{ block.settings.autoplay_speed }} * 1000);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
        window.removeEventListener('resize', () => this.handleResize());
      }
    }

    customElements.define('product-video-carousel-{{ ai_gen_id }}', ProductVideoCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product video carousel",
  "settings": [
    {
      "type": "header",
      "content": "Video source"
    },
    {
      "type": "text",
      "id": "video_metafield",
      "label": "Video metafield",
      "info": "Enter metafield namespace and key (e.g., custom.video_urls). Separate multiple video URLs with semicolons (;). Supports YouTube, Vimeo, and direct video URLs."
    },
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Product Videos"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Watch our product in action"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 800,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "videos_per_row_desktop",
      "label": "Videos per row (desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "videos_per_row_tablet",
      "label": "Videos per row (tablet)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
